#!/usr/bin/env bash
#
# tests/helpers/ensure_bash32 -- ensures a real GNU bash 3.2 is on hand for
# the suites that must observe actual bash-3.2 semantics -- e.g.
# `arr+=("${empty[@]}")` throwing "unbound variable" under `set -u`, a bug
# the host's bash (>= 4) does not have -- not a bash-version-agnostic
# stand-in for it (consumers: config-sync.bats, tier-hooks.bats). Sets/
# exports $BASH32 to a working, `--version`-confirmed 3.2.x binary.
#
# Sourceable (`. helpers/ensure_bash32`, e.g. from a bats setup_file, which
# then exports BASH32 for every test in the file) or directly executable
# (prints the resolved path on stdout). The shell-entry contract forbids
# "# skip" lines, so this fails loudly -- a message on stderr plus a
# non-zero return (sourced) or exit (executed) -- rather than ever silently
# falling back to the host bash.
#
# Resolution order, cheapest first:
#   0. the system bash is already 3.2 (true on a real Mac -- /bin/bash)
#   1. tests/.cache/bash32/bin/bash (gitignored; left by a previous run)
#   2. a prebuilt install already sitting in this session's scratchpad,
#      built by this same bead (CLAUDE_ORCA_BASH32_PREBUILT overrides it)
#   3. build GNU bash-3.2.57 from source (ftp.gnu.org) into the cache --
#      needs a C compiler and yacc/bison. The tarball's builtins/*.c are
#      generated from old K&R-style .def files whose prototypes
#      (`void write_endifs ();` = "unspecified args" pre-C23) fail to
#      compile as errors under gcc >= 14's default C23 dialect, hence
#      -std=gnu89 on both the host and *_FOR_BUILD compiler flags -- bash's
#      build uses a separately-flagged host tool (mkbuiltins) to generate
#      those .c files, so CFLAGS alone (without CFLAGS_FOR_BUILD) is not
#      enough. The tarball is fetched with verification and retries (see
#      _ensure_bash32_fetch_tarball) and the verified copy persists in
#      tests/.cache, keyed by URL, so a rebuild never re-fetches.

_ensure_bash32_have_32() {
    [ -x "$1" ] || return 1
    "$1" --version 2>/dev/null | head -1 | grep -q ' version 3\.2'
}

# bison without root. The folder's container runs as the `agent` user
# (uid 501) with no sudo password, so `sudo -n apt-get install -y bison`
# above is a no-op there and the whole shell-entry contract went red for a
# missing build tool rather than for anything about the shell. apt can
# still FETCH as an ordinary user as long as its list and cache dirs are
# ones the user owns, and a .deb is just an archive: unpack bison and its
# m4 dependency under the bash32 cache and point $PATH and, because the
# prefix moved, $BISON_PKGDATADIR at the copy. Cached with the bash it is
# there to build, so this costs one fetch per cache lifetime.
#
# Exports nothing globally beyond PATH/BISON_PKGDATADIR for this shell,
# which is exactly the scope the source build below needs.
_ensure_bash32_local_bison() {
    local cache_dir="$1" tools apt_opts deb attempt unpacked
    tools="$cache_dir/tools"

    if _ensure_bash32_have_bison "$tools"; then
        _ensure_bash32_use_bison "$tools"
        return 0
    fi

    command -v apt-get >/dev/null 2>&1 || return 1
    command -v dpkg-deb >/dev/null 2>&1 || return 1

    apt_opts="-o Dir::State::Lists=$tools/lists -o Dir::Cache=$tools/cache"

    # The unpack sits inside the retry with the fetch: a .deb that turns
    # out to be an error page fails dpkg-deb -x, and that is the same
    # transient-garbage failure the tarball fetch guards against, so the
    # answer is a clean re-fetch, not a fatal.
    for attempt in 1 2 3; do
        rm -rf "$tools"
        mkdir -p "$tools/debs" "$tools/lists/partial" "$tools/cache/archives/partial" \
            || return 1

        # `apt-get update` is what makes a candidate version visible; it
        # exits 0 with only W: lines when DNS is dead, so the download
        # below is what actually decides.
        ( cd "$tools/debs" && apt-get $apt_opts update ) >/dev/null 2>&1
        ( cd "$tools/debs" && apt-get $apt_opts download bison m4 ) >/dev/null 2>&1

        unpacked=1
        for deb in "$tools"/debs/*.deb; do
            [ -f "$deb" ] || continue
            dpkg-deb -x "$deb" "$tools/root" >/dev/null 2>&1 || unpacked=0
        done

        if [ "$unpacked" -eq 1 ] && _ensure_bash32_have_bison "$tools"; then
            _ensure_bash32_use_bison "$tools"
            return 0
        fi
    done
    return 1
}

_ensure_bash32_have_bison() {
    [ -x "$1/root/usr/bin/bison" ] || return 1
    BISON_PKGDATADIR="$1/root/usr/share/bison" \
        PATH="$1/root/usr/bin:$PATH" \
        "$1/root/usr/bin/bison" --version >/dev/null 2>&1
}

# Fetch the bash-3.2.57 tarball and prove it is one before calling it done.
# A zero-exit curl is not evidence of a tarball, for two reasons seen live
# on 2026-09-18: helpers/setup's stub curl answers `curl -o` with a fake
# DMG body and exit 0 (config-sync.bats loads that helper, so its tests
# see the stub), and the egress proxy has served 200s whose body was an
# error page. Both surfaced as `gzip: stdin: not in gzip format` in the
# middle of a suite run -- the case failing on the fetch, not on bash.
# So: fetch with helpers/setup's ORIGINAL_PATH (the clean PATH it exports
# precisely so a helper can ask for the real tools) when the suite
# provides it, plain PATH when run directly; validate with `tar tzf`
# (gzip structure AND tar structure), throw the body away and retry when
# it does not parse, and curl only after wget fails -- either tool alone
# has been enough.
_ensure_bash32_fetch_tarball() {
    local dest="$1" url="$2" attempt fetch_path
    fetch_path="${ORIGINAL_PATH:-$PATH}"
    for attempt in 1 2 3; do
        if ! ( cd "$(dirname "$dest")" \
               && PATH="$fetch_path" curl -fsSL "$url" -o "$dest" ) 2>/dev/null; then
            ( cd "$(dirname "$dest")" \
              && PATH="$fetch_path" wget -q "$url" -O "$dest" ) 2>/dev/null
        fi
        if tar tzf "$dest" >/dev/null 2>&1; then
            return 0
        fi
        rm -f "$dest"
    done
    return 1
}

# $M4 as well as $PATH: bison shells out to the m4 it was COMPILED against
# (/usr/bin/m4), not to whatever m4 is first on PATH, so an unpacked bison
# on a box with no system m4 dies with "m4 subprocess failed: No such file
# or directory" in the middle of the bash build. $M4 is the override it
# reads. $BISON_PKGDATADIR is the same story for its skeleton files.
_ensure_bash32_use_bison() {
    PATH="$1/root/usr/bin:$PATH"
    BISON_PKGDATADIR="$1/root/usr/share/bison"
    export PATH BISON_PKGDATADIR
    if [ -x "$1/root/usr/bin/m4" ]; then
        M4="$1/root/usr/bin/m4"
        export M4
    fi
}

_ensure_bash32() {
    local repo_root cache_dir prebuilt tarball_url build_dir src_dir permissive build_triple

    if _ensure_bash32_have_32 /bin/bash; then
        BASH32=/bin/bash
        return 0
    fi

    repo_root="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/../.." && pwd)"
    cache_dir="$repo_root/tests/.cache/bash32"

    if _ensure_bash32_have_32 "$cache_dir/bin/bash"; then
        BASH32="$cache_dir/bin/bash"
        return 0
    fi

    rm -rf "$cache_dir"
    mkdir -p "$cache_dir"

    prebuilt="${CLAUDE_ORCA_BASH32_PREBUILT:-/tmp/claude-1000/-workspace/7037bfad-67da-4b5e-9adb-944b260fc264/scratchpad/bash32/install}"
    if _ensure_bash32_have_32 "$prebuilt/bin/bash"; then
        if cp -R "$prebuilt/." "$cache_dir/" && _ensure_bash32_have_32 "$cache_dir/bin/bash"; then
            BASH32="$cache_dir/bin/bash"
            return 0
        fi
        echo "ensure_bash32: copy from prebuilt $prebuilt failed or didn't verify -- falling back to a source build" >&2
    fi

    # --- build from source ------------------------------------------------

    if ! command -v gcc >/dev/null 2>&1 && ! command -v cc >/dev/null 2>&1; then
        echo "ensure_bash32: no C compiler (gcc/cc) on PATH -- cannot build GNU bash 3.2.57" >&2
        return 1
    fi

    if ! command -v yacc >/dev/null 2>&1 && ! command -v bison >/dev/null 2>&1; then
        sudo -n apt-get install -y bison >/dev/null 2>&1
    fi
    if ! command -v yacc >/dev/null 2>&1 && ! command -v bison >/dev/null 2>&1; then
        _ensure_bash32_local_bison "$cache_dir" || {
            echo "ensure_bash32: no yacc/bison on PATH -- cannot regenerate bash-3.2.57's patched parser" >&2
            return 1
        }
    fi

    build_dir="$(mktemp -d)"
    src_dir="bash-3.2.57"
    tarball_url="${CLAUDE_ORCA_BASH32_URL:-https://ftp.gnu.org/gnu/bash/bash-3.2.57.tar.gz}"

    # The verified tarball outlives the build dir and the bash32 install
    # (it lives beside that dir, which the invalid-cache path rm -rf's) and
    # is keyed by URL, so a rebuild after a killed or failed run re-fetches
    # nothing -- the network only enters this file once per cache
    # lifetime, not once per build.
    tarball_cache="$repo_root/tests/.cache/bash-3.2.57-$(printf '%s' "$tarball_url" | cksum | cut -d' ' -f1).tar.gz"

    if ! tar tzf "$tarball_cache" >/dev/null 2>&1 \
        && ! _ensure_bash32_fetch_tarball "$tarball_cache" "$tarball_url"; then
        echo "ensure_bash32: failed to fetch a valid $tarball_url (no curl/wget, or no network)" >&2
        rm -rf "$build_dir"
        return 1
    fi
    cp "$tarball_cache" "$build_dir/bash-3.2.57.tar.gz"

    if ! (cd "$build_dir" && tar xzf bash-3.2.57.tar.gz); then
        echo "ensure_bash32: failed to extract bash-3.2.57.tar.gz" >&2
        rm -rf "$build_dir"
        return 1
    fi

    # config.guess in this tarball predates aarch64 (and most other current
    # triples) and can't guess the build system; --build sidesteps it
    # instead of patching the script. The mkbuiltins/mksyntax/etc. host
    # tools are old K&R C -- see the file header for why both CFLAGS and
    # CFLAGS_FOR_BUILD need the permissive dialect.
    build_triple="$(uname -m)-unknown-linux-gnu"
    permissive="-std=gnu89 -fcommon -Wno-implicit-function-declaration -Wno-implicit-int -g -O0"

    if ! (cd "$build_dir/$src_dir" \
            && ./configure --build="$build_triple" --prefix="$cache_dir" \
                   CC=gcc CFLAGS="$permissive" CFLAGS_FOR_BUILD="$permissive" \
                   >configure.log 2>&1 \
            && make -j4 >make.log 2>&1 \
            && make install >install.log 2>&1); then
        echo "ensure_bash32: building GNU bash-3.2.57 failed -- logs under $build_dir/$src_dir/{configure,make,install}.log" >&2
        tail -n 40 "$build_dir/$src_dir/make.log" 2>/dev/null >&2
        return 1
    fi

    rm -rf "$build_dir"

    if _ensure_bash32_have_32 "$cache_dir/bin/bash"; then
        BASH32="$cache_dir/bin/bash"
        return 0
    fi

    echo "ensure_bash32: built a bash at $cache_dir/bin/bash but it doesn't report version 3.2" >&2
    return 1
}

if _ensure_bash32; then
    export BASH32
    if [ "${BASH_SOURCE[0]:-x}" = "${0:-y}" ]; then
        printf '%s\n' "$BASH32"
    fi
else
    echo "ensure_bash32: FATAL -- no GNU bash 3.2 could be obtained; the shell-entry contract forbids skipping this check" >&2
    if [ "${BASH_SOURCE[0]:-x}" = "${0:-y}" ]; then
        exit 1
    fi
    return 1 2>/dev/null || exit 1
fi
