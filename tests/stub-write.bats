#!/usr/bin/env bats
#
# The project root's ./claude-dev stub (V1, claude-orca-qt9.1) is
# regenerated on every register. It used to be written with a bare
# `cat > "$dir/claude-dev"`, and `>` follows a symlink -- so a folder that
# already had a `claude-dev` SYMLINK at its root got the stub written
# through the link into whatever it finally pointed at. Reproduced by hand:
# with ./claude-dev -> .claude-dev/bin/claude-dev, itself the symlink
# link-bin.sh makes to ../template/scripts/launcher.sh, one `register`
# replaced the template's own 1100-line launcher with the three-line stub
# and bricked the folder -- every later ./claude-dev exec'd a stub that
# exec'd itself. Nothing in the current code creates that root link, so it
# is a latent landmine rather than a guaranteed break; the fix is to unlink
# before writing, and this is the test that holds it.
#
# The launcher's dispatch block runs on source, so write_project_stub is
# lifted out of the real file the way tests/launcher-v3-pull.bats lifts its
# functions, and driven directly.

load helpers/setup

LAUNCHER="$REPO_ROOT/scripts/launcher.sh"

lift_write_project_stub() {
    sed -n '/^write_project_stub()/,/^}/p' "$LAUNCHER"
}

# Runs the real write_project_stub against $1 in a shell of its own.
run_write_project_stub() {
    local fns
    fns="$(lift_write_project_stub)"
    [ -n "$fns" ]
    run bash -c "set -e
$fns
write_project_stub '$1'"
}

# The .claude-dev layout the reproduction needs: a template clone carrying
# the real launcher, and bin/claude-dev as the relative symlink link-bin.sh
# makes to it.
make_stub_project() {
    local dir="$1"
    mkdir -p "$dir/.claude-dev/template/scripts" "$dir/.claude-dev/bin"
    cp "$LAUNCHER" "$dir/.claude-dev/template/scripts/launcher.sh"
    chmod +x "$dir/.claude-dev/template/scripts/launcher.sh"
    ln -s ../template/scripts/launcher.sh "$dir/.claude-dev/bin/claude-dev"
}

# Runs the real cmd_key_v3 -- with the two helpers it needs -- against $1,
# reading the key from $2 rather than a tty.
lift_key_fns() {
    sed -n -e '/^openrouter_key_file()/,/^}/p' \
           -e '/^read_secret_value()/,/^}/p' \
           -e '/^cmd_key_v3()/,/^}/p' "$LAUNCHER"
}

run_cmd_key_v3() {
    local fns
    fns="$(lift_key_fns)"
    [ -n "$fns" ]
    run bash -c "set -e
PROJECT_SELF='$1'
CLAUDE_ORCA_KEY_INPUT='$2'
$fns
cmd_key_v3 openrouter '$1'"
}

@test "register writes the project stub without following a symlink" {
    proj="$BATS_TEST_TMPDIR/proj"
    make_stub_project "$proj"
    target="$proj/.claude-dev/template/scripts/launcher.sh"

    # The byte-for-byte copy the assertion at the end compares against.
    cp "$target" "$BATS_TEST_TMPDIR/launcher.before"
    before_lines="$(wc -l < "$target")"
    [ "$before_lines" -gt 100 ]

    # The landmine: ./claude-dev is a symlink, and it resolves -- through
    # bin/claude-dev -- to the template's own launcher.
    ln -s .claude-dev/bin/claude-dev "$proj/claude-dev"
    [ -L "$proj/claude-dev" ]
    [ "$(cd "$proj" && readlink -f claude-dev)" = "$(readlink -f "$target")" ]

    run_write_project_stub "$proj"
    [ "$status" -eq 0 ]

    # What the root now holds: a regular file, not a link, carrying the
    # stub, and executable.
    [ ! -L "$proj/claude-dev" ]
    [ -f "$proj/claude-dev" ]
    [ -x "$proj/claude-dev" ]
    grep -qF 'Generated by claude-dev register' "$proj/claude-dev"
    grep -qF '.claude-dev/bin/claude-dev' "$proj/claude-dev"

    # The point of the whole test: the link's former target is untouched.
    cmp "$BATS_TEST_TMPDIR/launcher.before" "$target"
    [ "$(wc -l < "$target")" -eq "$before_lines" ]

    # ...and so is the intermediate link, which still resolves to it.
    [ -L "$proj/.claude-dev/bin/claude-dev" ]
    [ "$(readlink "$proj/.claude-dev/bin/claude-dev")" = "../template/scripts/launcher.sh" ]
}

@test "the stub is rewritten in place when it is already a regular file" {
    proj="$BATS_TEST_TMPDIR/plain"
    make_stub_project "$proj"

    # The ordinary case: register over a folder that already has a stub --
    # here a stale one, so a rewrite is observable.
    printf '#!/usr/bin/env bash\necho stale\n' > "$proj/claude-dev"
    chmod +x "$proj/claude-dev"

    run_write_project_stub "$proj"
    [ "$status" -eq 0 ]

    [ -f "$proj/claude-dev" ]
    [ ! -L "$proj/claude-dev" ]
    [ -x "$proj/claude-dev" ]
    grep -qF 'Generated by claude-dev register' "$proj/claude-dev"
    run grep -qF 'echo stale' "$proj/claude-dev"
    [ "$status" -ne 0 ]

    # And on a folder that has no stub at all yet.
    fresh="$BATS_TEST_TMPDIR/fresh"
    make_stub_project "$fresh"
    [ ! -e "$fresh/claude-dev" ]
    run_write_project_stub "$fresh"
    [ "$status" -eq 0 ]
    [ -f "$fresh/claude-dev" ]
    [ -x "$fresh/claude-dev" ]
    grep -qF 'Generated by claude-dev register' "$fresh/claude-dev"
}

# The same defect, one write over: `claude-dev key openrouter` wrote the
# key with `( umask 077; printf ... > "$file" )` and then chmod 600. Both
# halves follow a symlink, so a link planted at
# .claude-dev/home/.openrouter.key hands the user's real API key to an
# arbitrary file AND relaxes that file to 600 -- the umask does not help,
# because an existing target keeps its own mode. This is the disclosure
# case, not just a damaged script.
@test "the OpenRouter key is never written through a symlink" {
    proj="$BATS_TEST_TMPDIR/keyproj"
    mkdir -p "$proj/.claude-dev/home"
    proj="$(cd "$proj" && pwd -P)"

    # What the link points at: an unrelated file the user already has,
    # with bytes and a mode of its own that both have to survive.
    target="$BATS_TEST_TMPDIR/innocent.txt"
    printf 'original bytes\n' > "$target"
    chmod 644 "$target"

    keyfile="$proj/.claude-dev/home/.openrouter.key"
    ln -s "$target" "$keyfile"
    [ -L "$keyfile" ]

    printf 'sk-or-v1-notarealkey\n' > "$BATS_TEST_TMPDIR/key.in"
    run_cmd_key_v3 "$proj" "$BATS_TEST_TMPDIR/key.in"
    [ "$status" -eq 0 ]

    # The key landed where it belongs: a regular file, not a link, 600.
    [ ! -L "$keyfile" ]
    [ -f "$keyfile" ]
    [ "$(cat "$keyfile")" = "sk-or-v1-notarealkey" ]
    [ "$(file_mode "$keyfile")" = "600" ]

    # The point of the test: the secret never reached the link's former
    # target, and the chmod never touched its mode either.
    [ "$(cat "$target")" = "original bytes" ]
    [ "$(file_mode "$target")" = "644" ]
}

# And the third: register's `[ ! -f "$(orca_json ...)" ]` guard follows
# symlinks, so a link to an existing file correctly skips the write -- but
# a DANGLING link passes the guard, and `cat >` then follows it and creates
# the defaults outside the project. Milder than the other two (it creates
# rather than destroys), same fix.
@test "claude-orca.json is not written through a dangling symlink" {
    run make_project_v3 "$PROJECT_DIR"
    [ "$status" -eq 0 ]

    config="$PROJECT_DIR/.claude-dev/claude-orca.json"
    outside="$BATS_TEST_TMPDIR/outside/config.json"
    mkdir -p "$(dirname "$outside")"

    rm -f "$config"
    ln -s "$outside" "$config"
    [ -L "$config" ]
    [ ! -e "$outside" ]

    run bash -c "cd '$PROJECT_DIR' && '$ORCA_HOST/bin/claude-dev' register"
    [ "$status" -eq 0 ]

    # The config is a real file at its own path inside the project...
    [ ! -L "$config" ]
    [ -f "$config" ]
    run jq -e '.version == 3' "$config"
    [ "$status" -eq 0 ]

    # ...and nothing was created at the link's target.
    [ ! -e "$outside" ]
}
