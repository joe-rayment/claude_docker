# Project name scopes all compose operations to THIS project only.
# Without this, all projects share the default name "claude-dev" (from the
# directory name), and `docker compose up` for one project tears down another.
name: ${CONTAINER_NAME}

services:
  claude-dev:
    build:
      context: .
      dockerfile: Dockerfile
    image: ${IMAGE_TAG}
    container_name: ${CONTAINER_NAME}

    # Use tini as PID 1 so signals (SIGTERM from docker stop) propagate
    # correctly to tmux and its child processes.
    init: true

    # Interactive terminal
    stdin_open: true
    tty: true

    # Volume mounts
    volumes:
      # Mount your project as workspace
      - ../:/workspace
      # Persistent home directory (includes .claude, .gitconfig, .zsh_history, etc.)
      - ${VOLUME_NAME}:/home/agent
      # Drop zone: share files from host (~/claude-drops → /drops)
      # Create ~/claude-drops on your host, then drop files there for Claude to see
      - ~/claude-drops:/drops
      # Host home directory (read-only) for drag-and-drop file access.
      # Dragged files paste their host path; this mount makes those paths resolve.
      - ${HOST_HOME}:${HOST_HOME}:ro

    # Allow container to reach host services
    extra_hosts:
      - "host.docker.internal:host-gateway"

    # Project identity (used by welcome screen, prompt, and dev-log)
    environment:
      - CLAUDE_PROJECT_NAME=${PROJECT_NAME}

    # Working directory
    working_dir: /workspace

    # Health check
    healthcheck:
      test: ["CMD-SHELL", "test -d /home/agent"]
      interval: 60s
      timeout: 10s
      retries: 2
      start_period: 30s

    # Restart policy
    restart: unless-stopped

    # Keep container running
    command: /bin/zsh

volumes:
  ${VOLUME_NAME}:
    driver: local
