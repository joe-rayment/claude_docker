{
  "model": "claude-opus-4-8",
  "advisorModel": "claude-fable-5",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "statusLine": {
    "type": "command",
    "command": "/home/agent/.claude/statusline.sh",
    "padding": 0
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "Bash(view-logs)",
      "Bash(dev-log:*)",
      "Bash(csearch:*)",
      "Read(~/.claude/debug/**)",
      "Read(/workspace/.claude/logs/**)",
      "Write(/home/agent/.claude/exported-logs/**)",
      "Write(/workspace/.claude/logs/**)",
      "WebSearch",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:www.anthropic.com)",
      "WebFetch(domain:docs.docker.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:gist.github.com)",
      "WebFetch(domain:deepwiki.com)",
      "WebFetch(domain:medium.com)",
      "WebFetch(domain:dev.to)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Reminder: lead with the answer; include only what changes the reader'\\''s next action, in plain complete sentences — no process narration, no unasked-for caveats. Explicit user constraints are binding: never substitute your preference, even while debugging. If you noticed a flaw in your work, fix it or state it — never ship it silently.'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "bd prime" }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "bd prime" }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p /home/agent/.claude/exported-logs && cp ~/.claude/debug/latest /home/agent/.claude/exported-logs/last-session.log 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
