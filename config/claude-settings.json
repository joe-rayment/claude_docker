{
  "env": {
    "ANTHROPIC_LOG": "debug"
  },
  "permissions": {
    "allow": [
      "Bash(ralph)",
      "Bash(ralph-*)",
      "Bash(view-logs)",
      "Read(~/.claude/debug/**)",
      "Write(/workspace/logs/**)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p /workspace/logs && cp ~/.claude/debug/latest /workspace/logs/last-session.log 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
