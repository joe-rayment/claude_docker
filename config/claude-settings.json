{
  "model": "opus",
  "respondToBashCommands": false,
  "skipDangerousModePermissionPrompt": true,
  "promptSuggestionEnabled": false,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SILENT_TURN_REMINDER": "false",
    "CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION": "false",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "1000000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50",
    "BEADS_ACTOR": "claude"
  },
  "statusLine": {
    "type": "command",
    "command": "__HOST__/template/bin/statusline",
    "padding": 0
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "__HOST__/template/bin/statusline-subagent"
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "Bash(view-logs)",
      "Bash(dev-log:*)",
      "Bash(csearch:*)",
      "WebSearch",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:www.anthropic.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:gist.github.com)",
      "WebFetch(domain:deepwiki.com)",
      "WebFetch(domain:medium.com)",
      "WebFetch(domain:dev.to)"
    ],
    "deny": [
      "Bash(snow *)",
      "Bash(snowsql *)"
    ]
  },
  "subagentPromptCacheTtl": "1h",
  "enableAllProjectMcpServers": true,
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "[ -x \"__HOST__/template/bin/outbound-guard\" ] && exec \"__HOST__/template/bin/outbound-guard\" --prompt; exit 0" },
          { "type": "command", "command": "[ -x \"__HOST__/template/bin/cost-mirror\" ] && exec \"__HOST__/template/bin/cost-mirror\"; exit 0" },
          { "type": "command", "command": "[ -x \"__HOST__/template/bin/tier-prime\" ] && exec \"__HOST__/template/bin/tier-prime\" --short; exit 0" },
          { "type": "command", "command": "[ -x \"__HOST__/template/bin/lane\" ] && exec \"__HOST__/template/bin/lane\" --prompt; exit 0" },
          { "type": "command", "command": "[ -x \"__HOST__/template/bin/session-title\" ] && exec \"__HOST__/template/bin/session-title\"; exit 0" }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "[ -x \"__HOST__/template/bin/prime-memories\" ] && exec \"__HOST__/template/bin/prime-memories\"; exit 0" },
          { "type": "command", "command": "[ -x \"__HOST__/template/bin/context-detect\" ] && exec \"__HOST__/template/bin/context-detect\"; exit 0" },
          { "type": "command", "command": "[ -x \"__HOST__/template/bin/code-map-prime\" ] && exec \"__HOST__/template/bin/code-map-prime\"; exit 0" },
          { "type": "command", "command": "[ -x \"__HOST__/template/bin/disk-cleanup\" ] && (\"__HOST__/template/bin/disk-cleanup\" >/dev/null 2>&1 &); exit 0" },
          { "type": "command", "command": "__HOST__/template/bin/tier-reconcile" },
          { "type": "command", "command": "__HOST__/template/bin/tier-prime" },
          { "type": "command", "command": "[ -x \"__HOST__/template/bin/cost-mirror\" ] && (timeout 3 \"__HOST__/template/bin/cost-mirror\" --refresh-pricing >/dev/null 2>&1 &); exit 0" },
          { "type": "command", "command": "[ -x \"__HOST__/template/bin/provision\" ] && exec \"__HOST__/template/bin/provision\" status --failed; exit 0" },
          { "type": "command", "command": "[ -x \"__HOST__/template/bin/worktree-gc\" ] && exec \"__HOST__/template/bin/worktree-gc\" --quiet; exit 0" },
          { "type": "command", "command": "[ -x \"__HOST__/template/bin/offramp\" ] && exec \"__HOST__/template/bin/offramp\" --session-start; exit 0" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "[ -x \"__HOST__/template/bin/worktree-gc\" ] && exec \"__HOST__/template/bin/worktree-gc\" --after-merge; exit 0" }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "[ -x \"__HOST__/template/bin/context-meter\" ] && exec \"__HOST__/template/bin/context-meter\" --post; exit 0" },
          { "type": "command", "command": "[ -x \"__HOST__/template/bin/offramp\" ] && exec \"__HOST__/template/bin/offramp\" --post; exit 0" }
        ]
      }
    ],
    "PostModelSwitch": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "__HOST__/template/bin/tier-reconcile" }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "user_settings",
        "hooks": [
          { "type": "command", "command": "__HOST__/template/bin/tier-reconcile" }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "[ -x \"__HOST__/template/bin/export-logs\" ] && exec \"__HOST__/template/bin/export-logs\"; exit 0" },
          { "type": "command", "command": "[ -x \"__HOST__/template/bin/offramp\" ] && exec \"__HOST__/template/bin/offramp\" --stop; exit 0" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "[ -x \"__HOST__/template/bin/session-end-audit\" ] && exec \"__HOST__/template/bin/session-end-audit\"; exit 0" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "[ -x \"__HOST__/template/bin/bd-guard\" ] && exec \"__HOST__/template/bin/bd-guard\"; exit 0" },
          { "type": "command", "command": "[ -x \"__HOST__/template/bin/branch-guard\" ] && exec \"__HOST__/template/bin/branch-guard\"; exit 0" },
          { "type": "command", "command": "[ -x \"__HOST__/template/bin/outbound-guard\" ] && exec \"__HOST__/template/bin/outbound-guard\"; exit 0" },
          { "type": "command", "command": "[ -x \"__HOST__/template/bin/contract-gate\" ] && exec \"__HOST__/template/bin/contract-gate\"; exit 0", "timeout": 10 },
          { "type": "command", "command": "[ -x \"__HOST__/template/bin/output-cap\" ] && exec \"__HOST__/template/bin/output-cap\"; exit 0", "timeout": 10 }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          { "type": "command", "command": "__HOST__/template/bin/tier-gate" }
        ]
      },
      {
        "matcher": "Workflow",
        "hooks": [
          { "type": "command", "command": "[ -x \"__HOST__/template/bin/workflow-lint\" ] && exec \"__HOST__/template/bin/workflow-lint\"; exit 0" }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Bash|Edit|Write|NotebookEdit|Agent|Workflow",
        "hooks": [
          { "type": "command", "command": "[ -x \"__HOST__/template/bin/delegation-gate\" ] && exec \"__HOST__/template/bin/delegation-gate\"; exit 0", "timeout": 10 }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "[ -x \"__HOST__/template/bin/context-meter\" ] && exec \"__HOST__/template/bin/context-meter\" --pre; exit 0" },
          { "type": "command", "command": "[ -x \"__HOST__/template/bin/offramp\" ] && exec \"__HOST__/template/bin/offramp\" --pre; exit 0" }
        ]
      }
    ]
  }
}
