{
  "model": "claude-sonnet-4-6",
  "advisorModel": "claude-opus-4-7",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "statusLine": {
    "type": "command",
    "command": "/home/agent/.claude/statusline.sh",
    "padding": 0
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "Bash(view-logs)",
      "Bash(dev-log:*)",
      "Bash(csearch:*)",
      "Read(~/.claude/debug/**)",
      "Read(/workspace/.claude/logs/**)",
      "Write(/home/agent/.claude/exported-logs/**)",
      "Write(/workspace/.claude/logs/**)",
      "WebSearch",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:www.anthropic.com)",
      "WebFetch(domain:docs.docker.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:gist.github.com)",
      "WebFetch(domain:deepwiki.com)",
      "WebFetch(domain:medium.com)",
      "WebFetch(domain:dev.to)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "playwright"
  ],
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Reminder: answer tersely — just the facts, no filler, no unneeded words or explanation unless the user asks you to expand. Talk like a caveman with modern grammar: short, blunt, lead with the answer.'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "bd prime" }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "bd prime" }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p /home/agent/.claude/exported-logs && cp ~/.claude/debug/latest /home/agent/.claude/exported-logs/last-session.log 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
