{
  "model": "opus",
  "advisorModel": "fable",
  "respondToBashCommands": false,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "BEADS_ACTOR": "claude"
  },
  "statusLine": {
    "type": "command",
    "command": "/home/agent/.claude/statusline.sh",
    "padding": 0
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "Bash(view-logs)",
      "Bash(dev-log:*)",
      "Bash(csearch:*)",
      "Read(~/.claude/debug/**)",
      "Read(/workspace/.claude/logs/**)",
      "Edit(/home/agent/.claude/exported-logs/**)",
      "Edit(/workspace/.claude/logs/**)",
      "WebSearch",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:www.anthropic.com)",
      "WebFetch(domain:docs.docker.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:gist.github.com)",
      "WebFetch(domain:deepwiki.com)",
      "WebFetch(domain:medium.com)",
      "WebFetch(domain:dev.to)"
    ],
    "deny": [
      "Bash(snow *)",
      "Bash(snowsql *)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "command -v tier-reconcile >/dev/null 2>&1 && tier-reconcile >/dev/null 2>&1; true"
          },
          {
            "type": "command",
            "command": "command -v cost-mirror >/dev/null 2>&1 && exec cost-mirror; [ -x \"$HOME/.claude/hooks/cost-mirror\" ] && exec \"$HOME/.claude/hooks/cost-mirror\"; exit 0"
          },
          {
            "type": "command",
            "command": "e=$(grep -m1 '^model:' \"$HOME/.claude/agents/executor.md\" 2>/dev/null | sed 's/^model:[[:space:]]*//'); s=$(grep -m1 '^model:' \"$HOME/.claude/agents/scout.md\" 2>/dev/null | sed 's/^model:[[:space:]]*//'); [ -n \"$e\" ] && echo \"[tier] worker=$e recon=${s:-?} — dispatch: recon→scout · slices→executor · claims→verifier · trivial→inline\"; true"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime"
          },
          {
            "type": "command",
            "command": "command -v context-detect >/dev/null 2>&1 && context-detect; true"
          },
          {
            "type": "command",
            "command": "command -v disk-cleanup >/dev/null 2>&1 && (disk-cleanup >/dev/null 2>&1 &); true"
          },
          {
            "type": "command",
            "command": "command -v tier-reconcile >/dev/null 2>&1 && tier-reconcile >/dev/null 2>&1; true"
          },
          {
            "type": "command",
            "command": "m=$(jq -r '.model // empty' \"$HOME/.claude/settings.json\" 2>/dev/null); e=$(grep -m1 '^model:' \"$HOME/.claude/agents/executor.md\" 2>/dev/null | sed 's/^model:[[:space:]]*//'); s=$(grep -m1 '^model:' \"$HOME/.claude/agents/scout.md\" 2>/dev/null | sed 's/^model:[[:space:]]*//'); echo \"tier → orchestrator(settings model)=${m:-harness default}  executor=${e:-sonnet (frontmatter)}  scout=${s:-haiku (frontmatter)} | verifier+oracle inherit the session model\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p /home/agent/.claude/exported-logs && cp ~/.claude/debug/latest /home/agent/.claude/exported-logs/last-session.log 2>/dev/null || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v bd-guard >/dev/null 2>&1 && exec bd-guard; exit 0"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "command -v tier-gate >/dev/null 2>&1 && exec tier-gate; [ -x \"$HOME/.claude/hooks/tier-gate\" ] && exec \"$HOME/.claude/hooks/tier-gate\"; exit 0"
          }
        ]
      },
      {
        "matcher": "Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "command -v workflow-lint >/dev/null 2>&1 && exec workflow-lint; [ -x \"$HOME/.claude/hooks/workflow-lint\" ] && exec \"$HOME/.claude/hooks/workflow-lint\"; exit 0"
          }
        ]
      }
    ]
  }
}
