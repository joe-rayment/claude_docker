# claude-dev ghostty v1
# revision 2
# Installed by `claude-dev ghostty`. Your config includes it with
#   config-file = ?claude-dev.ghostty
# Delete that line (or `claude-dev ghostty --uninstall`) and Ghostty is stock.

# Every new pane, split, tab and window starts here: inside a sandboxed folder
# it opens that folder's container, anywhere else your normal login shell. The
# router runs as a child, never exec'd. Router missing -> your login shell
# directly. Router exits 0 -> the tab closes. ANY failure, or ctrl-c while it
# starts -> a one-line banner and your Mac login shell in the same tab, so a
# broken router or launcher can never take the shell away. To undo:
#   rm ~/.local/share/claude-dev/ghostty-pane   every tab a plain Mac shell
#   claude-dev ghostty --uninstall              Ghostty stock
# and as the floor, the Mac's Terminal app never reads this file.
command = /bin/sh -c 'r="$HOME/.local/share/claude-dev/ghostty-pane"; s="${SHELL:-/bin/zsh}"; [ -x "$s" ] || s=/bin/zsh; [ -x "$r" ] || exec "$s" -l; trap : INT; "$r" && exit 0; echo "== pane ended with status $? -- Mac shell, NOT sandboxed. To stop the routing: rm $r ==" >&2; exec "$s" -l'

# `command` is no longer a shell, so Ghostty cannot detect one; naming it keeps
# Ghostty's shell integration in Mac panes. (Written from $SHELL at install.)
shell-integration = @SHELL_INTEGRATION@

# Splits and tabs stay where you are -- in a sandbox pane, that is the sandbox.
# A NEW WINDOW (cmd+n) starts in your home folder: a Mac shell. That is the
# one-keystroke way out.
window-inherit-working-directory = false
