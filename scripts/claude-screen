#!/bin/sh
# claude-screen — wrap Claude Code with alternate screen to fix tmux scroll.
#
# Problem: Claude Code doesn't enter the alternate screen buffer (smcup/rmcup),
# so tmux's #{alternate_on} flag stays false. Our WheelUpPane binding relies on
# that flag to suppress copy-mode (which would show shell history from before
# Claude started).
#
# Solution: Enter alternate screen before launching Claude, exit on cleanup.
# This makes #{alternate_on}=1 while Claude runs, so the WheelUpPane binding
# correctly eats scroll events instead of entering copy-mode.

# Only wrap when running inside tmux — outside tmux there's no issue.
if [ -z "$TMUX" ]; then
    exec claude "$@"
fi

# Enter alternate screen and clear it.
printf '\033[?1049h\033[H\033[2J'

# Restore normal screen on any exit (normal, ctrl-c, kill).
cleanup() {
    printf '\033[?1049l'
}
trap cleanup EXIT INT TERM HUP

# Run Claude Code with all arguments.
claude "$@"
