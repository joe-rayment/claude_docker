#!/usr/bin/env bash
#
# claude-orca-shell -- the S2 wrapper. Every shell opened inside a
# bootstrapped project's folder re-execs itself through this before any
# agent binary runs (see shellrc.zsh/shellrc.bash and
# .claude/plans/orca-port.md S3.2). Trust boundary: this script never
# sources or executes anything under <primary>/<worktree> --
# <primary>/.claude-dev/sandbox.json is read only as validated data, by
# gen-settings.sh.
#
# Usage:
#   claude-orca-shell --root <primary> [--cwd <dir>] -- <shell> [-c <cmd>]
#   claude-orca-shell --check --root <primary> [--cwd <dir>]
#   claude-orca-shell --print-settings --root <primary> [--cwd <dir>]
#   claude-orca-shell --print-env --root <primary> [--cwd <dir>]
#   claude-orca-shell --selftest [--root <primary>] [--cwd <dir>]
#
# `-- <shell> -c <cmd>` (e.g. `-- zsh -c "$cmd"`) preserves a non-
# interactive login shell's pending command through the re-exec: the
# inner shell becomes `exec <shell> -l -c '<cmd>'`, with <cmd> shell-quoted
# exactly once (see shell_quote below).
#
# --selftest [--root <primary>] [--cwd <dir>] (--root defaults to
# claude-orca-root's detection from --cwd/$PWD when omitted): runs
# scripts/sandbox/selftest.sh's 13 probes inside the sandbox (S3, see
# .claude/plans/orca-port.md S3) and writes
# <primary>/.claude-dev/state/selftest.json. Exits with the self-test's
# own exit code (0 = all probes PASS/N/A, 1 = at least one FAIL). If srt
# itself can't even start -- no results JSON appears -- writes a
# synthetic single-probe "srt-launch" FAIL result instead and exits 1.
# srt's stderr (SRT_DEBUG=true, the generated Seatbelt profile) is saved
# to <primary>/.claude-dev/state/srt-debug-<sha1>.log for audit.
#
# Auth (S5, claude-orca-3sk.17): --check also reports
# "auth: credentials present|absent" for Claude Code's own
# <config dir>/.credentials.json; run mode prints the guided first-run
# line while that file is absent, runs bin/auth-guard before touching
# anything (fatal on ANTHROPIC_API_KEY/_AUTH_TOKEN/_BASE_URL unless
# CLAUDE_DEV_ALLOW_API_BILLING=1), and passes the host's `gh auth token`
# into srt as a masked GH_TOKEN.
#
# Exit codes: 0 ok; 1 auth-guard veto; 2 invalid input / scope rejected by gen-settings.sh;
# 3 already sandboxed (CLAUDE_ORCA_SANDBOXED=1); 4 srt/sandbox-exec
# missing.

set -euo pipefail

resolve_script_path() {
    local src="${BASH_SOURCE[0]}"
    while [ -L "$src" ]; do
        local link dir
        link="$(readlink "$src")"
        case "$link" in
            /*) src="$link" ;;
            *)  dir="$(cd "$(dirname "$src")" && pwd)"; src="$dir/$link" ;;
        esac
    done
    echo "$src"
}

SCRIPT_PATH="$(resolve_script_path)"
SANDBOX_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
GEN_SETTINGS="$SANDBOX_DIR/gen-settings.sh"
TEMPLATE_DIR="$(cd "$SANDBOX_DIR/../.." && pwd)"
ROOT_BIN="$SANDBOX_DIR/claude-orca-root"

# HOST = ~/.claude-orca (override: CLAUDE_ORCA_HOME), independent of
# where this copy of the script physically lives (template checkout vs.
# the ~/.claude-orca/bin symlink) -- see .claude/plans/orca-port.md S3.1.
HOST="${CLAUDE_ORCA_HOME:-$HOME/.claude-orca}"
REAL_HOME="${CLAUDE_ORCA_REAL_HOME:-$HOME}"

die() {
    echo "claude-orca-shell: $1" >&2
    exit "$2"
}

# Wraps $1 in single quotes for exactly one safe embedding into the shell
# command string handed to `srt -c` -- each embedded single quote becomes
# '\'' (close quote, escaped literal quote, reopen quote). Deliberately not
# bash's `printf %q` (output style/escaping differs across bash versions,
# and this must produce identical quoting under bash 3.2 and the host's
# bash); this sed-based form was verified byte-identical between both in
# tests/shell-entry.bats.
shell_quote() {
    local q
    q="$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
    printf "'%s'" "$q"
}

# Shared by the run and --selftest side-effect paths below (both need a
# stable per-worktree settings-file name).
sha1_of() {
    if command -v sha1sum >/dev/null 2>&1; then
        printf '%s' "$1" | sha1sum | cut -d' ' -f1
    else
        printf '%s' "$1" | shasum -a 1 | cut -d' ' -f1
    fi
}

usage() {
    cat <<'USAGE'
Usage:
  claude-orca-shell --root <primary> [--cwd <dir>] -- <shell> [-c <cmd>]
  claude-orca-shell --check --root <primary> [--cwd <dir>]
  claude-orca-shell --print-settings --root <primary> [--cwd <dir>]
  claude-orca-shell --print-env --root <primary> [--cwd <dir>]
  claude-orca-shell --selftest [--root <primary>] [--cwd <dir>]
USAGE
}

MODE="run"
PRIMARY=""
CWD_OPT=""
SHELL_BIN="zsh"
SHELL_CMD=""
HAVE_SHELL_CMD=0

while [ $# -gt 0 ]; do
    case "$1" in
        --root)            PRIMARY="$2"; shift 2 ;;
        --cwd)             CWD_OPT="$2"; shift 2 ;;
        --check)           MODE="check"; shift ;;
        --print-settings)  MODE="print-settings"; shift ;;
        --print-env)       MODE="print-env"; shift ;;
        --selftest)        MODE="selftest"; shift ;;
        --help|-h)         usage; exit 0 ;;
        --)
            shift
            if [ $# -gt 0 ]; then
                SHELL_BIN="$1"
                shift
            fi
            # A trailing `-c <cmd>` after the inner shell name carries a
            # non-interactive login shell's command through the re-exec
            # (shellrc.zsh/.bash: $ZSH_EXECUTION_STRING/$BASH_EXECUTION_STRING)
            # -- see .claude/plans/orca-port.md S3.2.
            if [ $# -gt 0 ] && [ "$1" = "-c" ]; then
                shift
                [ $# -gt 0 ] || die "-c requires a command argument" 2
                SHELL_CMD="$1"
                HAVE_SHELL_CMD=1
                shift
            fi
            break
            ;;
        *) die "unknown argument: $1" 2 ;;
    esac
done

if [ "$MODE" = "selftest" ] && [ -z "$PRIMARY" ]; then
    # --root is optional for --selftest: default to claude-orca-root's
    # detection from --cwd/$PWD, same as shellrc.zsh/.bash do.
    if [ -x "$ROOT_BIN" ]; then
        PRIMARY="$("$ROOT_BIN" --cwd "${CWD_OPT:-$PWD}" 2>/dev/null)" || PRIMARY=""
    fi
    [ -n "$PRIMARY" ] || die "--selftest: not inside a bootstrapped project and --root not given" 2
fi

[ -n "$PRIMARY" ] || die "--root is required" 2

if [ -n "${CLAUDE_ORCA_SANDBOXED:-}" ]; then
    die "already sandboxed (CLAUDE_ORCA_SANDBOXED=1) -- refusing to nest" 3
fi

if [ ! -d "$PRIMARY" ]; then
    die "--root is not a directory: $PRIMARY" 2
fi
PRIMARY="$(cd "$PRIMARY" && pwd -P)"

CWD_DIR="${CWD_OPT:-$PWD}"
if [ ! -d "$CWD_DIR" ]; then
    die "--cwd is not a directory: $CWD_DIR" 2
fi
CWD_DIR="$(cd "$CWD_DIR" && pwd -P)"

# Best-effort canonicalization -- if HOST/REAL_HOME don't exist yet, leave
# them as-is and let the checks below (srt presence, gen-settings.sh's own
# --real-home validation) fail with a precise, specific reason instead.
canon_if_dir() {
    if [ -d "$1" ]; then
        (cd "$1" && pwd -P)
    else
        printf '%s\n' "$1"
    fi
}
HOST="$(canon_if_dir "$HOST")"
REAL_HOME="$(canon_if_dir "$REAL_HOME")"

SRT_BIN="$HOST/srt/node_modules/.bin/srt"
[ -x "$SRT_BIN" ] || die "srt not found at $SRT_BIN -- run claude-dev bootstrap again" 4

if [ "$(uname -s)" = "Darwin" ]; then
    command -v sandbox-exec >/dev/null 2>&1 || die "sandbox-exec not found on PATH (macOS Seatbelt)" 4
fi

WORKTREE=""
if [ -x "$ROOT_BIN" ]; then
    WORKTREE="$("$ROOT_BIN" --worktree --cwd "$CWD_DIR" 2>/dev/null)" || WORKTREE=""
fi
[ -n "$WORKTREE" ] || WORKTREE="$CWD_DIR"

SANDBOX_JSON="$PRIMARY/.claude-dev/sandbox.json"

# S5 (claude-orca-3sk.17): the GitHub token is read HERE, on the host,
# where the Keychain and ~/.config/gh still exist -- inside the sandbox
# neither does. It is handed to srt through the process environment only
# (masked there via credentials.envVars, see gen-settings.sh), never
# written under the project and never echoed: --print-env deliberately
# omits it. `gh auth token` failing (not installed, not logged in) is not
# an error -- the project simply runs without a token.
GH_TOKEN_HOST=""
if command -v gh >/dev/null 2>&1; then
    GH_TOKEN_HOST="$(gh auth token 2>/dev/null || true)"
fi
# Unquoted on purpose: always set (so `set -u` is happy) and either empty
# -- expanding to no argument at all -- or exactly one flag word.
GH_TOKEN_FLAG=""
if [ -n "$GH_TOKEN_HOST" ]; then
    GH_TOKEN_FLAG="--gh-token-present"
fi

if ! SETTINGS_JSON="$("$GEN_SETTINGS" \
    --primary "$PRIMARY" \
    --worktree "$WORKTREE" \
    --real-home "$REAL_HOME" \
    --host "$HOST" \
    $GH_TOKEN_FLAG \
    --sandbox-json "$SANDBOX_JSON" 2>&1)"; then
    die "invalid sandbox scope for $PRIMARY: $SETTINGS_JSON" 2
fi

if [ "$MODE" = "print-settings" ]; then
    printf '%s\n' "$SETTINGS_JSON"
    exit 0
fi

# --- env block (single source of truth for run/--print-env) -------------

SANDBOX_HOME="$PRIMARY/.claude-dev/home"
SANDBOX_TMP="$PRIMARY/.claude-dev/tmp"

ENV_HOME="$SANDBOX_HOME"
ENV_CLAUDE_CONFIG_DIR="$SANDBOX_HOME/.claude"
ENV_TMPDIR="$SANDBOX_TMP"
ENV_GIT_CONFIG_GLOBAL="$SANDBOX_HOME/.gitconfig"
ENV_GH_CONFIG_DIR="$SANDBOX_HOME/.config/gh"
ENV_BEADS_DIR="$PRIMARY/.beads"
ENV_ORCA_USER_DATA_PATH="$REAL_HOME/Library/Application Support/orca"
USR_LOCAL_DIR="/usr/local"
ENV_PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$REAL_HOME/.local/bin:$HOST/template/bin:$USR_LOCAL_DIR/bin:/usr/bin:/bin:/usr/sbin:/sbin"

print_env_lines() {
    cat <<EOF
HOME=$ENV_HOME
CLAUDE_CONFIG_DIR=$ENV_CLAUDE_CONFIG_DIR
TMPDIR=$ENV_TMPDIR
GIT_CONFIG_GLOBAL=$ENV_GIT_CONFIG_GLOBAL
GH_CONFIG_DIR=$ENV_GH_CONFIG_DIR
BEADS_DIR=$ENV_BEADS_DIR
ORCA_USER_DATA_PATH=$ENV_ORCA_USER_DATA_PATH
DISABLE_AUTOUPDATER=1
CLAUDE_ORCA_SANDBOXED=1
CLAUDE_ORCA_REAL_HOME=$REAL_HOME
CLAUDE_ORCA_ROOT=$PRIMARY
PATH=$ENV_PATH
EOF
}

if [ "$MODE" = "print-env" ]; then
    print_env_lines
    exit 0
fi

# S5: Claude Code's own OAuth credentials, written by the guided first run
# INSIDE the sandbox (Apple Events are denied and there is no `open`, so
# the login URL is printed and the code pasted back). 0600, under the
# faked HOME's config dir -- never in the repo, never in the Keychain.
CREDENTIALS_FILE="$ENV_CLAUDE_CONFIG_DIR/.credentials.json"

if [ "$MODE" = "check" ]; then
    if [ -f "$CREDENTIALS_FILE" ]; then
        echo "auth: credentials present"
    else
        echo "auth: credentials absent"
    fi
    exit 0
fi

# --- MODE = run / selftest: side effects start here -----------------------

# S5: billing hard-guard, before anything is written and before srt is
# ever reached -- ANTHROPIC_API_KEY/_AUTH_TOKEN/_BASE_URL silently flip
# Claude Code from subscription to API billing. Run mode only: --selftest
# exits with the self-test's own probe status, which a guard veto must not
# impersonate.
if [ "$MODE" = "run" ] && [ -x "$TEMPLATE_DIR/bin/auth-guard" ]; then
    "$TEMPLATE_DIR/bin/auth-guard" || die "auth-guard refused to start this shell" 1
fi

mkdir -p "$SANDBOX_HOME" "$SANDBOX_TMP" "$PRIMARY/.claude-dev/state"

# Host side, before exec/selftest: keep the primary checkout's config dir
# current with this template's config/ (S7, claude-orca-3sk.7). Best-effort
# -- a sync failure here must not block a shell the user can otherwise use
# to go fix it.
CONFIG_SYNC_SCRIPT="$HOST/template/scripts/config-sync.sh"
if [ -x "$CONFIG_SYNC_SCRIPT" ]; then
    "$CONFIG_SYNC_SCRIPT" --project "$PRIMARY" --host "$HOST" || true
fi

SETTINGS_FILE="$PRIMARY/.claude-dev/state/srt-$(sha1_of "$WORKTREE").json"
printf '%s\n' "$SETTINGS_JSON" > "$SETTINGS_FILE"
chmod 600 "$SETTINGS_FILE"

# S6 (claude-orca-3sk.18): carry Orca's managed hook entries from the real
# (unsandboxed) home's .claude/settings.json into the sandboxed config dir
# (the agent never reads that one), and chain Orca's statusline. Cosmetic
# integration -- never fatal to a launch. See scripts/orca-hooks-merge.sh
# and .claude/plans/orca-port.md S3.5.
ORCA_MERGE="$SANDBOX_DIR/../orca-hooks-merge.sh"
if [ -x "$ORCA_MERGE" ]; then
    "$ORCA_MERGE" --real-home "$REAL_HOME" --config-dir "$ENV_CLAUDE_CONFIG_DIR" || \
        echo "[claude-orca] Orca hook merge skipped (see above)" >&2
fi

# S6: Orca reads $CLAUDE_CONFIG_DIR/projects from its OWN process env, not
# the agent's, so a project whose sandbox.json says Orca cannot see the
# config dir gets a .claude/projects/<slug> link under the real home,
# pointed at the sandboxed transcripts dir. <slug> is Claude Code's slug: the
# worktree path with `/` and `.` replaced by `-`. Opt-in, and a real
# directory already sitting in that slot is never touched.
if [ "$(jq -r '.orca.transcriptSymlink // false' "$SANDBOX_JSON" 2>/dev/null)" = "true" ]; then
    TRANSCRIPT_SLUG="$(printf '%s' "$WORKTREE" | tr '/.' '-')"
    TRANSCRIPT_LINK="$REAL_HOME/.claude/projects/$TRANSCRIPT_SLUG"
    TRANSCRIPT_TARGET="$ENV_CLAUDE_CONFIG_DIR/projects/$TRANSCRIPT_SLUG"
    if [ -e "$TRANSCRIPT_LINK" ] && [ ! -L "$TRANSCRIPT_LINK" ]; then
        echo "[claude-orca] not replacing existing $TRANSCRIPT_LINK with a symlink" >&2
    else
        mkdir -p "$REAL_HOME/.claude/projects" "$TRANSCRIPT_TARGET"
        ln -sfn "$TRANSCRIPT_TARGET" "$TRANSCRIPT_LINK"
    fi
fi

export HOME="$ENV_HOME"
export CLAUDE_CONFIG_DIR="$ENV_CLAUDE_CONFIG_DIR"
export TMPDIR="$ENV_TMPDIR"
export GIT_CONFIG_GLOBAL="$ENV_GIT_CONFIG_GLOBAL"
export GH_CONFIG_DIR="$ENV_GH_CONFIG_DIR"
export BEADS_DIR="$ENV_BEADS_DIR"
export ORCA_USER_DATA_PATH="$ENV_ORCA_USER_DATA_PATH"
export DISABLE_AUTOUPDATER=1
export CLAUDE_ORCA_SANDBOXED=1
export CLAUDE_ORCA_REAL_HOME="$REAL_HOME"
export CLAUDE_ORCA_ROOT="$PRIMARY"
export PATH="$ENV_PATH"

# Env-only, and only when there is something to pass: srt masks it inside
# the sandbox (credentials.envVars) and injects the real value on egress
# to github.com/api.github.com.
if [ -n "$GH_TOKEN_HOST" ]; then
    export GH_TOKEN="$GH_TOKEN_HOST"
fi

if [ "$MODE" = "selftest" ]; then
    # Extra exports for the selftest process only -- never added to
    # print_env_lines/the run-mode env block above, which
    # tests/sandbox-config.bats pins to an exact line count.
    export CLAUDE_ORCA_SETTINGS="$SETTINGS_FILE"
    export CLAUDE_ORCA_HOST="$HOST"
    if [ -n "${CLAUDE_ORCA_SELFTEST_FAKE:-}" ]; then
        export CLAUDE_ORCA_SELFTEST_FAKE
    fi
    if [ -n "${CLAUDE_ORCA_SELFTEST_TRACE:-}" ]; then
        export CLAUDE_ORCA_SELFTEST_TRACE
    fi

    RESULTS_JSON="$PRIMARY/.claude-dev/state/selftest.json"
    DEBUG_LOG="$PRIMARY/.claude-dev/state/srt-debug-$(sha1_of "$WORKTREE").log"
    SELFTEST_SCRIPT="$HOST/template/scripts/sandbox/selftest.sh"

    rm -f "$RESULTS_JSON"
    SELFTEST_CMD="$(shell_quote "$SELFTEST_SCRIPT") --json-out $(shell_quote "$RESULTS_JSON")"

    set +e
    SRT_DEBUG=true "$SRT_BIN" --settings "$SETTINGS_FILE" -c "$SELFTEST_CMD" 2>"$DEBUG_LOG"
    SELFTEST_RC=$?
    set -e

    if [ ! -f "$RESULTS_JSON" ]; then
        STDERR_TAIL="$(tail -n 40 "$DEBUG_LOG" 2>/dev/null)"
        jq -n \
            --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
            --arg root "$PRIMARY" \
            --arg worktree "$WORKTREE" \
            --arg platform "$(uname -s)" \
            --arg detail "srt exited $SELFTEST_RC before the self-test could run: $STDERR_TAIL" \
            '{
                timestamp: $ts,
                srt_version: "",
                platform: $platform,
                root: $root,
                worktree: $worktree,
                probes: [{name: "srt-launch", status: "FAIL", detail: $detail}],
                summary: {pass: 0, fail: 1, na: 0}
            }' > "$RESULTS_JSON"
        exit 1
    fi

    exit "$SELFTEST_RC"
fi

if [ "$PRIMARY" = "$WORKTREE" ]; then
    echo "[claude-orca] sandboxed: writes limited to $PRIMARY" >&2
else
    echo "[claude-orca] sandboxed: writes limited to $WORKTREE (+ $PRIMARY/.git, .beads, .claude-dev)" >&2
fi

if [ ! -f "$CREDENTIALS_FILE" ]; then
    echo "[claude-orca] no Claude credentials yet -- run 'claude', open the printed URL on the Mac, paste the code; stored at $CREDENTIALS_FILE" >&2
fi

if [ "$HAVE_SHELL_CMD" -eq 1 ]; then
    exec "$SRT_BIN" --settings "$SETTINGS_FILE" -c "exec $SHELL_BIN -l -c $(shell_quote "$SHELL_CMD")"
fi
exec "$SRT_BIN" --settings "$SETTINGS_FILE" -c "exec $SHELL_BIN -l"
