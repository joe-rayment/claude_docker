#!/usr/bin/env bash
#
# claude-orca-root -- prints the primary checkout of a bootstrapped
# project for $PWD (or --cwd <dir>); --worktree prints the current
# worktree's top-level instead (== primary in a primary session).
#
# Read-only recon: never writes, execs, or sources anything under the
# project it inspects (see .claude/plans/orca-port.md S3.1). "Bootstrapped"
# means <primary>/.claude-dev/sandbox.json exists. Exit 0 with the path on
# stdout; exit 1 silently (no output at all) otherwise, so callers
# (shellrc.zsh/shellrc.bash) can treat "not bootstrapped" as ordinary.

cwd="$PWD"
mode="primary"

while [ $# -gt 0 ]; do
    case "$1" in
        --cwd)
            if [ $# -lt 2 ]; then
                exit 1
            fi
            cwd="$2"
            shift 2
            ;;
        --worktree)
            mode="worktree"
            shift
            ;;
        *)
            exit 1
            ;;
    esac
done

if [ ! -d "$cwd" ]; then
    exit 1
fi
cwd="$(cd "$cwd" && pwd -P)" || exit 1

# Absolute git-common-dir for $1 (the shared .git dir, same for the
# primary checkout and every linked worktree), or failure if $1 isn't
# inside a git working tree.
git_common_dir() {
    local out
    out="$(cd "$1" && git rev-parse --git-common-dir 2>/dev/null)"
    if [ -z "$out" ]; then
        return 1
    fi
    case "$out" in
        /*) printf '%s\n' "$out" ;;
        *)  printf '%s\n' "$1/$out" ;;
    esac
}

find_primary() {
    local dir="$1" common
    if common="$(git_common_dir "$dir")"; then
        (cd "$common/.." && pwd -P)
        return $?
    fi
    # Non-git: walk up looking for .claude-dev/sandbox.json.
    while :; do
        if [ -f "$dir/.claude-dev/sandbox.json" ]; then
            printf '%s\n' "$dir"
            return 0
        fi
        if [ "$dir" = "/" ]; then
            return 1
        fi
        dir="$(cd "$dir/.." && pwd -P)" || return 1
    done
}

primary="$(find_primary "$cwd")" || exit 1
if [ ! -f "$primary/.claude-dev/sandbox.json" ]; then
    exit 1
fi

if [ "$mode" = "worktree" ]; then
    worktree="$(cd "$cwd" && git rev-parse --show-toplevel 2>/dev/null)"
    if [ -n "$worktree" ]; then
        worktree="$(cd "$worktree" && pwd -P)" || exit 1
    else
        worktree="$primary"
    fi
    printf '%s\n' "$worktree"
else
    printf '%s\n' "$primary"
fi
