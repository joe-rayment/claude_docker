#!/usr/bin/env bash
#
# orca-launch -- the HOST side of layer 1 (.claude/plans/orca-port.md
# §9.1): regenerate the Seatbelt profile for this folder, point HOME and
# TMPDIR inside it, and hand the folder's own copy of Orca to
# sandbox-exec. Reached as <project>/.claude-dev/bin/orca-launch, either
# from the Orca.app launcher bundle in the project root (double-click) or
# by hand.
#
# Usage: orca-launch [--project <dir>] [--app <Orca.app>]
#                    [--print-command | --print-env] [args for Orca]
#
# --print-env prints the exports a launch would make and exits;
# --print-command prints those and the sandbox-exec command line. Both
# resolve the project and the app exactly as a launch does, and do
# nothing else: no sandbox-exec required, no profile, no symlink, no
# directories, no app.
#
# The project is derived from this script's own resolved location
# (.claude-dev/template/scripts/sandbox/ -> the project) via paths.sh, so
# neither PATH nor the working directory matters; --project and
# $CLAUDE_ORCA_ROOT override it, in that order.
#
# Fail closed: no sandbox-exec, no profile, or no app bundle means no
# launch. Running Orca unsandboxed is exactly what this folder exists to
# prevent, so there is no fallback path.
#
# Why `orca repo add` runs from a backgrounded helper: the last thing
# this script does is REPLACE itself with sandbox-exec (exec), so the app
# inherits the terminal and the process tree stays flat -- there is no
# "after" in this process. The helper is started first, waits for Orca to
# write its runtime metadata (orca-runtime.json under the user data dir,
# src/shared/runtime-bootstrap.ts:45), then runs the CLI bundled inside
# the app (Contents/Resources/bin/orca, per Orca's own Casks/orca.rb) ONCE
# with the project's path. `repo add` on an already-added path is a
# no-op that must never fail the launch, so its exit status is logged and
# discarded. Its stdio goes to the launch log, never the terminal.

set -euo pipefail

_self="${BASH_SOURCE[0]}"
while [ -L "$_self" ]; do
    _link="$(readlink "$_self")"
    case "$_link" in
        /*) _self="$_link" ;;
        *)  _self="$(cd "$(dirname "$_self")" && pwd)/$_link" ;;
    esac
done
SCRIPT_DIR="$(cd "$(dirname "$_self")" && pwd)"
# shellcheck source=scripts/lib/paths.sh
. "$SCRIPT_DIR/../lib/paths.sh"

# $2 is the exit status: 1 for "this launch cannot proceed", 2 for the
# two refusals that are about the SHORT ROOT rather than the folder (a
# squatted path, a path too long for the socket) -- callers, and the
# tests, tell them apart by status.
die() {
    echo "orca-launch: $1" >&2
    exit "${2:-1}"
}

# Shell-quotes $1 only when it needs it, so --print-command's output is
# copy-pasteable ("Application Support" has a space in it).
shq() {
    case "$1" in
        *[!A-Za-z0-9_/.:@%+,=-]*) printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")" ;;
        *) printf '%s' "$1" ;;
    esac
}

# The short per-project root that Orca's user data dir hangs off. macOS's
# sockaddr_un is 104 bytes total, and Orca puts its unix socket inside the
# user data dir, so the folder's own (arbitrarily deep) path cannot be it.
# One stable root per project, derived from the project's path.
short_root_for() {
    local project="$1" hash prefix
    if command -v shasum >/dev/null 2>&1; then
        hash="$(printf '%s' "$project" | shasum | cut -c1-8)"
    else
        hash="$(printf '%s' "$project" | sha1sum | cut -c1-8)"
    fi
    case "$(uname -s)" in
        Darwin) prefix="/private/tmp" ;;
        *)      prefix="/tmp" ;;
    esac
    printf '%s/co-%s' "$prefix" "$hash"
}

# /tmp is sticky and world-writable: never follow or reuse an entry we did
# not verify. Ours (a symlink to this folder's home) is kept, a symlink
# somewhere else is replaced, anything else refuses the launch.
ensure_short_root() {
    local root="$1" target="$2"
    if [ -L "$root" ]; then
        [ "$(readlink "$root")" = "$target" ] && return 0
        rm -f "$root"
    elif [ -e "$root" ]; then
        die "refusing: $root exists and is not the claude_orca symlink for this project" 2
    fi
    mkdir -p "$(dirname "$root")"
    ln -s "$target" "$root"
}

project=""
app=""
mode="run"
orca_args=()

while [ $# -gt 0 ]; do
    case "$1" in
        --project) project="$2"; shift 2 ;;
        --app)     app="$2"; shift 2 ;;
        --print-command) mode="print-command"; shift ;;
        --print-env)     mode="print-env"; shift ;;
        # Everything else belongs to Orca (Finder adds its own flags).
        *) orca_args=(${orca_args[@]+"${orca_args[@]}"} "$1"); shift ;;
    esac
done

[ -n "$project" ] || project="$(project_dir)" || die "cannot tell which project this is; pass --project <dir>"
[ -d "$project" ] || die "project directory does not exist: $project"
project="$(cd "$project" && pwd -P)"

[ -n "$app" ] || app="$project/.claude-dev/app/Orca.app"
APP_BIN="$app/Contents/MacOS/Orca"
ORCA_CLI="$app/Contents/Resources/bin/orca"
[ -x "$APP_BIN" ] || die "no Orca app in this folder: $APP_BIN (run 'claude-dev register' first)"

# Captured before HOME is repointed: the profile denies the real home.
REAL_HOME="${CLAUDE_ORCA_REAL_HOME:-$HOME}"

STATE_DIR="$project/.claude-dev/state"
PROFILE="$STATE_DIR/orca.sb"
LAUNCH_LOG="$STATE_DIR/orca-launch.log"

# Where Orca's user data goes (claude-orca-0h7). Not $HOME/Library/...:
# packaged Orca never calls app.setPath('userData'), and Electron's appData
# on macOS comes from NSSearchPath, which ignores $HOME -- so the app wrote
# to the REAL ~/Library/Application Support/orca, which the profile denies,
# and died on its SingletonLock. Orca's own kei() then overwrites
# process.env.ORCA_USER_DATA_PATH with app.getPath('userData'), so the env
# var alone cannot move it either. What Electron does honour, natively and
# before Orca's single-instance lock, is --user-data-dir (verified on the
# Linux build: SingletonLock, orca-runtime.json and the socket all landed
# under the switch's path and nothing under ~/.config/orca). The env var
# stays for the bundled CLI, which reads it (src/cli/runtime/metadata.ts:50).
SHORT_ROOT="${CLAUDE_ORCA_SHORT_ROOT:-$(short_root_for "$project")}"
ORCA_USER_DATA_PATH="$SHORT_ROOT/Library/Application Support/orca"

# macOS's sockaddr_un holds 104 bytes; Orca's socket name (o-<n>.sock and
# friends) needs ~20 of them after the directory, so a user data dir over
# 100 bytes cannot carry a working transport. Refuse rather than launch an
# app whose CLI can never connect.
if [ $((${#ORCA_USER_DATA_PATH} + 20)) -gt 100 ]; then
    die "refusing: the Orca user data dir is too long for a unix socket -- $ORCA_USER_DATA_PATH (${#ORCA_USER_DATA_PATH} bytes; macOS caps a socket path at 104, and Orca's socket name needs ~20 more). Set CLAUDE_ORCA_SHORT_ROOT to something shorter." 2
fi

export ORCA_USER_DATA_PATH
export HOME="$project/.claude-dev/home"
export TMPDIR="$project/.claude-dev/tmp"
export CLAUDE_ORCA_ROOT="$project"
export CLAUDE_ORCA_REAL_HOME="$REAL_HOME"
# V3 (claude-orca-qt9.3): the marker every terminal Orca opens inherits.
# It is what tells the self-test's four layer-1 probes that they are
# inside the Seatbelt profile and can actually observe it; anywhere else
# they report N/A rather than claim a confinement nobody applied.
export CLAUDE_ORCA_LAYER="orca"

# The exports a launch makes, in the order it makes them.
print_env() {
    printf 'HOME=%s\n' "$HOME"
    printf 'TMPDIR=%s\n' "$TMPDIR"
    printf 'CLAUDE_ORCA_ROOT=%s\n' "$CLAUDE_ORCA_ROOT"
    printf 'CLAUDE_ORCA_REAL_HOME=%s\n' "$CLAUDE_ORCA_REAL_HOME"
    printf 'CLAUDE_ORCA_LAYER=%s\n' "$CLAUDE_ORCA_LAYER"
    printf 'ORCA_USER_DATA_PATH=%s\n' "$ORCA_USER_DATA_PATH"
}

case "$mode" in
    print-env)
        print_env
        exit 0
        ;;
    print-command)
        print_env
        printf 'sandbox-exec -f %s %s %s' \
            "$(shq "$PROFILE")" "$(shq "$APP_BIN")" \
            "$(shq "--user-data-dir=$ORCA_USER_DATA_PATH")"
        for _arg in ${orca_args[@]+"${orca_args[@]}"}; do
            printf ' %s' "$(shq "$_arg")"
        done
        printf '\n'
        exit 0
        ;;
esac

command -v sandbox-exec >/dev/null 2>&1 \
    || die "sandbox-exec not found -- refusing to start Orca unsandboxed"

# The short root is a symlink INTO the folder, so every write through it
# lands in the project and the Seatbelt profile needs no new rule.
ensure_short_root "$SHORT_ROOT" "$project/.claude-dev/home"

mkdir -p "$STATE_DIR" "$project/.claude-dev/home" "$project/.claude-dev/tmp" \
         "$project/.claude-dev/home/Library/Application Support/orca"

"$SCRIPT_DIR/gen-orca-profile.sh" --project "$project" --real-home "$REAL_HOME" \
    --app "$app" --sandbox-json "$project/.claude-dev/sandbox.json" \
    > "$PROFILE.tmp" || die "could not generate the sandbox profile (see the message above)"
mv "$PROFILE.tmp" "$PROFILE"

# Registers this folder with the app once it is listening. Never fatal.
add_repo_when_ready() {
    local timeout="${CLAUDE_ORCA_METADATA_TIMEOUT:-120}" waited=0
    local metadata="$ORCA_USER_DATA_PATH/orca-runtime.json"
    while [ ! -f "$metadata" ]; do
        if [ "$waited" -ge "$timeout" ]; then
            echo "orca repo add skipped: runtime metadata did not appear within ${timeout}s ($metadata)"
            return 0
        fi
        sleep 1
        waited=$((waited + 1))
    done
    if [ ! -x "$ORCA_CLI" ]; then
        echo "orca repo add skipped: no bundled CLI at $ORCA_CLI"
        return 0
    fi
    echo "orca repo add --path $project --json"
    "$ORCA_CLI" repo add --path "$project" --json || \
        echo "orca repo add exited $? (already added is fine)"
    return 0
}

{
    echo "--- $(date -u '+%Y-%m-%dT%H:%M:%SZ') launching $APP_BIN"
} >> "$LAUNCH_LOG"
add_repo_when_ready >> "$LAUNCH_LOG" 2>&1 </dev/null &

echo "Orca (sandboxed to $project)"
echo "  profile: $PROFILE"
echo "  logs:    $LAUNCH_LOG"

exec sandbox-exec -f "$PROFILE" "$APP_BIN" \
    "--user-data-dir=$ORCA_USER_DATA_PATH" ${orca_args[@]+"${orca_args[@]}"}
