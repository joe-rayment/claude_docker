#!/usr/bin/env bash
#
# The image carries no Claude Code. This step is the template's install and
# update of Claude Code's own native install in the folder's home: a link at
# ~/.local/bin/claude into ~/.local/share/claude/versions/<v>, the same
# layout `claude update` writes, so an update run in a session moves the
# same link and the next start never downgrades it. At every start the step
# fetches the latest release, verifies its sha256, and points the link at
# it. Measured with real binaries on 2026-09-22: an old home copy shadowed
# every rebuild; zsh had hashed the image's copy, so `cs` ran it even after
# `claude update`; and a link at the image's binary is one `claude update`
# refuses to move.
# claude-orca-11c: the download temp file lives beside versions/, not inside
# it -- versions/ is managed by Claude Code's own installer, which can clean
# or truncate a file there mid-download, as on the 2026-10-01 Mac boot.

set -uo pipefail
. "$(dirname "$0")/../provision-lib.sh"

RELEASES="${CLAUDE_ORCA_CLAUDE_RELEASES:-https://downloads.claude.ai/claude-code-releases}"
AGENT_HOME="${HOME:-/home/agent}"
HOME_BIN="$AGENT_HOME/.local/bin/claude"
VDIR="$AGENT_HOME/.local/share/claude/versions"

semver() { grep -Eo '^[0-9]+\.[0-9]+\.[0-9]+' | head -1; }

# A plain file where the link belongs is not ours to replace: someone put it
# there on purpose.
if [ -e "$HOME_BIN" ] && [ ! -L "$HOME_BIN" ]; then
    echo "$HOME_BIN is a file, not Claude Code's native-install link; leaving it alone" >&2
    exit 1
fi

# Only a link into versions/ is the native installer's; anything else
# (missing, broken, a link at the image's old copy) reads as no native
# install.
home_v=""
if [ -L "$HOME_BIN" ]; then
    resolved="$(readlink -f "$HOME_BIN" 2>/dev/null || true)"
    vreal="$(readlink -f "$VDIR" 2>/dev/null || printf '%s' "$VDIR")"
    case "$resolved" in
        "$vreal"/?*)
            [ -x "$resolved" ] && home_v="$(basename "$resolved" | semver)" ;;
    esac
fi

# What is the latest release?
latest="$(curl -fsSL --max-time 10 "$RELEASES/latest" 2>/dev/null | tr -d '[:space:]')"
if ! printf '%s\n' "$latest" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'; then
    if [ -n "$home_v" ]; then
        echo "cannot reach $RELEASES/latest; keeping claude $home_v"
        exit 0
    fi
    echo "no Claude Code in $HOME_BIN and cannot reach $RELEASES/latest" >&2
    exit 1
fi

if [ -n "$home_v" ]; then
    newest="$(printf '%s\n%s\n' "$home_v" "$latest" | sort -V | tail -1)"
    if [ "$newest" = "$home_v" ]; then
        echo "claude $home_v is current (latest $latest)"
        exit 0
    fi
fi

# Install: download to a UNIQUE temp file beside versions/, never inside it,
# verify the checksum, and only then move it into versions/ and move the
# link -- a half-written binary is never linked, and nothing in versions/ is
# read or written before the binary is whole.
case "$(uname -m)" in
    aarch64|arm64) platform="linux-arm64" ;;
    x86_64|amd64)  platform="linux-x64" ;;
    *)
        echo "cannot install claude: unsupported architecture $(uname -m)" >&2
        exit 1
        ;;
esac
manifest="$(curl -fsSL --max-time 30 "$RELEASES/$latest/manifest.json" 2>/dev/null)"
checksum="$(printf '%s\n' "$manifest" | jq -r ".platforms[\"$platform\"].checksum // empty" 2>/dev/null)"
if ! printf '%s\n' "$checksum" | grep -Eq '^[a-f0-9]{64}$'; then
    echo "cannot read a sha256 for $platform from $RELEASES/$latest/manifest.json" >&2
    exit 1
fi

mkdir -p "$VDIR" "$(dirname "$HOME_BIN")" || {
    echo "cannot create $VDIR or $(dirname "$HOME_BIN")" >&2
    exit 1
}
DL_DIR="$(dirname "$VDIR")"
if ! tmp="$(mktemp "$DL_DIR/.claude-orca-dl.XXXXXX")"; then
    echo "claude: cannot create a download temp file in $DL_DIR" >&2
    echo "claude: installing $latest failed; $HOME_BIN is untouched" >&2
    exit 1
fi
rc=0
# ~243 MB; 600 s covers the ~2.5 MB/s a Mac measured (CLAUDE.md).
curl -fsSL --max-time 600 "$RELEASES/$latest/$platform/claude" -o "$tmp" || rc=$?
if [ "$rc" -ne 0 ]; then
    rm -f "$tmp"
    echo "claude: download of $latest failed (curl exit $rc)" >&2
    echo "claude: installing $latest failed; $HOME_BIN is untouched" >&2
    exit 1
fi
if [ ! -s "$tmp" ]; then
    rm -f "$tmp"
    echo "claude: download of $latest came back empty" >&2
    echo "claude: installing $latest failed; $HOME_BIN is untouched" >&2
    exit 1
fi
got="$(sha256sum "$tmp" | awk '{print $1}')"
if [ "$got" != "$checksum" ]; then
    rm -f "$tmp"
    echo "claude: $latest failed its sha256 check (want $checksum, got $got)" >&2
    echo "claude: installing $latest failed; $HOME_BIN is untouched" >&2
    exit 1
fi
chmod 755 "$tmp" \
    && mv -f "$tmp" "$VDIR/$latest" \
    && ln -sfn "$VDIR/$latest" "$HOME_BIN" || {
    rm -f "$tmp"
    echo "claude: installing $latest failed; $HOME_BIN is untouched" >&2
    exit 1
}
echo "claude: $HOME_BIN -> $VDIR/$latest (was ${home_v:-no native install})"
