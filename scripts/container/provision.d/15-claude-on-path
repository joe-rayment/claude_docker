#!/usr/bin/env bash
#
# `claude` on PATH is the newest Claude Code this container holds.
#
# A container can hold two copies. The image's copy is /opt/claude/claude
# (/usr/local/bin/claude on PATH), installed at whatever downloads.claude.ai
# called latest when `claude-dev --update` built the image. The other is
# Claude Code's own native install, which `claude update` writes into the
# folder's home: ~/.local/bin/claude, a symlink into
# ~/.local/share/claude/versions/<v>. That home is a bind mount, so it
# outlives every rebuild, and ~/.local/bin comes first on PATH (the
# Dockerfile's ENV, config/.zshrc). Because of one `claude update` on
# 2026-09-14, every later --update built the latest into the image, yet
# every terminal kept running the September 14 copy, and
# DISABLE_AUTOUPDATER kept it there.
#
# So on every start the newer copy wins. If the home copy is older, its link
# is repointed at the image's binary. If it is newer (a `claude update`
# since the last build), it stays until a build catches up. The step
# repoints the link rather than removing it, because installMethod=native in
# the home's .claude.json expects ~/.local/bin/claude to exist. The copies left in
# versions/ belong to disk-cleanup (6d): once the link points outside
# versions/, every copy there is stale.

set -uo pipefail
. "$(dirname "$0")/../provision-lib.sh"

AGENT_HOME="${HOME:-/home/agent}"
IMAGE_DIR="${CLAUDE_ORCA_CLAUDE_DIR:-/opt/claude}"
IMAGE_BIN="$IMAGE_DIR/claude"
HOME_BIN="$AGENT_HOME/.local/bin/claude"

semver() { grep -Eo '^[0-9]+\.[0-9]+\.[0-9]+' | head -1; }

if [ ! -L "$HOME_BIN" ] && [ ! -e "$HOME_BIN" ]; then
    echo "no Claude Code in $HOME_BIN; claude on PATH is the image's $IMAGE_BIN"
    exit 0
fi
if [ ! -x "$IMAGE_BIN" ]; then
    echo "no Claude Code at $IMAGE_BIN; leaving $HOME_BIN alone"
    exit 0
fi

image_v=""
[ -r "$IMAGE_DIR/VERSION" ] && image_v="$(semver < "$IMAGE_DIR/VERSION")"
[ -n "$image_v" ] || image_v="$("$IMAGE_BIN" --version 2>/dev/null | semver)"
if [ -z "$image_v" ]; then
    echo "cannot tell the version of $IMAGE_BIN; leaving $HOME_BIN alone" >&2
    exit 1
fi

if [ ! -L "$HOME_BIN" ]; then
    echo "$HOME_BIN is a file, not Claude Code's native-install link; it shadows the image's $image_v on PATH" >&2
    exit 1
fi

resolved="$(readlink -f "$HOME_BIN" 2>/dev/null || true)"
if [ "$resolved" = "$(readlink -f "$IMAGE_BIN")" ]; then
    echo "claude is the image's $image_v ($HOME_BIN -> $IMAGE_BIN)"
    exit 0
fi

# A versions/<v> target names its own version; a broken link or an
# unrecognised target is treated as older than anything.
home_v=""
if [ -n "$resolved" ] && [ -x "$resolved" ]; then
    home_v="$(basename "$resolved" | semver)"
    [ -n "$home_v" ] || home_v="$("$resolved" --version 2>/dev/null | semver)"
fi

if [ -n "$home_v" ]; then
    newest="$(printf '%s\n%s\n' "$image_v" "$home_v" | sort -V | tail -1)"
    if [ "$home_v" = "$image_v" ]; then
        echo "claude is $home_v either way ($HOME_BIN -> $resolved; image $IMAGE_BIN)"
        exit 0
    fi
    if [ "$newest" = "$home_v" ]; then
        echo "keeping $HOME_BIN at $home_v: newer than the image's $image_v"
        exit 0
    fi
fi

if ln -sf "$IMAGE_BIN" "$HOME_BIN"; then
    echo "claude: $HOME_BIN now -> $IMAGE_BIN (image $image_v; was ${home_v:-unknown} at ${resolved:-a broken link})"
else
    echo "could not repoint $HOME_BIN at $IMAGE_BIN" >&2
    exit 1
fi
