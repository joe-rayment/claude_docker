#!/usr/bin/env bash
#
# Install Orca's bundled "orchestration" skill for this folder, once.
#
# claude-orca-riu.3 already decided this: native Orca orchestration on by
# default for newly registered folders. It shipped against an OLDER
# architecture -- a Mac-side sandbox.json {"orca":{"cli":true}} flag threaded
# through a socket bridge, because Orca ran unsandboxed on the Mac while the
# sandboxed agent needed a socket to reach it. The 8uo epic moved Orca
# INSIDE the same container as the agent (this file's CLAUDE.md), so there
# is no socket to expose and no flag to set -- but nothing ever ported
# riu.3's actual installation step onto the mechanism that replaced it. This
# step is that port: it restores the already-decided default through
# `orca skills install`, it does not decide it again. The old sandbox.json
# path is dead code; nothing reads it any more.
#
# A real network call (npx hitting a registry) -- exactly the shape
# 60-orca-repo-add and 70-openrouter-guard already are -- which is why this
# lives here in provision.d and not in the early-sync path claude-orca-0jn
# added, which is reserved for fast, non-network, must-not-race work.
#
# --local, and never the bare command's default: every other piece of state
# in this codebase is scoped to the folder that started it (one container
# per folder, no central install -- CLAUDE.md's Architecture Overview). The
# plain command installs GLOBALLY, for every project on the host sharing
# this Orca -- the one thing in this whole system that would reach outside
# the folder it started in. Do not drop it.
#
# Idempotent: `orca skills installed` is asked first, and install only runs
# when "orchestration" is not already in what it lists -- never on every
# boot. That check must match the skill's NAME exactly, never a substring
# over the whole output (claude-orca-4gx, superseding claude-orca-ndy):
# `orca skills installed` prints a name (hash) selector line AND an
# indented prose description per skill, and Orca's bundled descriptions
# cross-reference each other by name ("pairs with the orchestration
# skill..."), so an unanchored `*orchestration*` match on another skill's
# description alone claims orchestration is installed and skips forever,
# with a green status row every boot. The primary check is therefore
# `skills installed --json`'s structured name field via jq -e, exact
# equality; the fallback (jq missing, or --json unsupported by an older
# Orca) requires the real selector shape exactly -- "orchestration" at
# column 0 followed by a space and an open paren, the one thing every
# other line Orca prints (indented descriptions, warnings, prose) is not
# (claude-orca-8v9, superseding claude-orca-01u). If neither check can
# give a confident yes, this step falls through to attempting the install
# rather than skipping it:
# skills install is itself idempotent, so a redundant install only costs
# one network call, while a wrongful skip costs the whole feature,
# silently.
#
# Non-fatal like every sibling step: a failed install (offline, npx
# missing, registry down) is logged and this step exits non-zero so
# `provision status` surfaces it at the next prompt -- provision-run.sh's
# own "no step is fatal" contract is what keeps the boot going from there;
# this step does not swallow the failure into a false success to get there.

set -uo pipefail
. "$(dirname "$0")/../provision-lib.sh"

AGENT_HOME="${HOME:-/home/agent}"
ORCA_BIN="${ORCA_BIN:-/opt/orca/orca-ide}"

# Resolved exactly the way 60-orca-repo-add and 65-worktree-sweep resolve
# it: same binary, same candidates, so a folder that registered with one
# copy of Orca asks that same copy about its skills.
resolve_cli() {
    if [ -n "${ORCA_CLI:-}" ]; then
        printf '%s\n' "$ORCA_CLI"
        return 0
    fi
    for candidate in \
        "$(dirname "$ORCA_BIN")/resources/bin/orca-ide" \
        "$AGENT_HOME/.local/bin/orca-ide" \
        "$AGENT_HOME/.local/bin/orca"
    do
        [ -x "$candidate" ] && { printf '%s\n' "$candidate"; return 0; }
    done
    for name in orca orca-ide; do
        found="$(command -v "$name" 2>/dev/null)"
        [ -n "$found" ] && { printf '%s\n' "$found"; return 0; }
    done
    return 1
}

cli="$(resolve_cli || true)"
if [ -z "$cli" ]; then
    echo "no Orca CLI found; skipping the orchestration skill install" >&2
    exit 0
fi

# Every call names this container's Orca the way 60-orca-repo-add does:
# without ORCA_USER_DATA_PATH the CLI asks whichever Orca its own default
# user-data dir points at, not the one this entrypoint started.
export ORCA_USER_DATA_PATH="${ORCA_USER_DATA_DIR:-$AGENT_HOME/.config/orca}"

# Exact-name idempotency check -- see the file header for why this can
# never be a substring match. already_installed stays 1 (attempt the
# install) unless one of the checks below confidently says yes.
#
# --json is AUTHORITATIVE: once it exits 0 AND its output actually parses
# as JSON, that answer is final in BOTH directions and the plain fallback
# below is never consulted, whether it found a match or not (claude-orca-
# 01u, superseding claude-orca-4gx). A confident "not installed" from
# --json must not be overruled by a fuzzy plain-text match, and a zero
# exit carrying non-JSON garbage must not count as confident either --
# hence the separate `jq -e .` parse check before ever asking the
# .result.skills[] question.
already_installed=1
json_output="$("$cli" skills installed --json 2>/dev/null)"
json_rc=$?
json_authoritative=1
if [ "$json_rc" -eq 0 ] && command -v jq >/dev/null 2>&1 \
    && printf '%s' "$json_output" | jq -e . >/dev/null 2>&1
then
    json_authoritative=0
    if printf '%s' "$json_output" \
        | jq -e '.result.skills[] | select(.name == "orchestration")' >/dev/null 2>&1
    then
        already_installed=0
    fi
fi

if [ "$json_authoritative" -ne 0 ]; then
    # --json didn't give a confident answer (unsupported, non-zero exit,
    # or a zero exit that didn't even parse) -- fall through to the
    # plain-text fallback. A real selector line is a name (hash) pair at
    # column 0 -- "orchestration (<hash>)" -- with its prose description
    # indented beneath it; nothing else Orca prints is both flush-left AND
    # followed immediately by an open paren. Requiring the paren, not just
    # the start-of-line anchor, is what rejects "warning: orchestration
    # index stale", a bare "orchestration" line, and unpunctuated prose
    # like "pairs with the orchestration skill" or "requires the
    # orchestration skill present" -- all of them either lack the name at
    # column 0, or have it without the parenthesised hex id that only a
    # real selector entry carries.
    #
    # The paren alone was not enough, and that cost a fourth pass: a
    # flush-left "orchestration (see docs)" -- an Orca notice, a changelog
    # line, a "(deprecated)" banner, a description whose first word is the
    # skill name -- is parenthesised prose, not an entry. Real entries
    # carry a hex id ("beads (4fd0b6c853425a56)"), so the id is what is
    # matched (claude-orca-clw, superseding claude-orca-8v9). Any
    # input this does not confidently recognise falls through to
    # attempting the install rather than skipping it: a redundant install
    # costs one idempotent network call, a wrongful skip costs the whole
    # feature, silently, forever.
    plain_output="$("$cli" skills installed 2>/dev/null)"
    if printf '%s\n' "$plain_output" | grep -qE '^orchestration \([0-9a-f]{6,}\)$'; then
        already_installed=0
    fi
fi

if [ "$already_installed" -eq 0 ]; then
    echo "the orchestration skill is already installed; nothing to do"
    exit 0
fi

echo "installing Orca's orchestration skill: $cli skills install --skill orchestration --local"
if "$cli" skills install --skill orchestration --local; then
    echo "orchestration skill installed"
    exit 0
fi
echo "orchestration skill install failed -- the next start will retry it" >&2
exit 1
