#!/usr/bin/env bash
#
# Is the OpenRouter chokepoint actually answering?
#
# The guard STARTS in the entrypoint, before serve, and that is deliberate
# rather than left over: Orca's process environment is fixed at exec, and
# the fail-closed rule -- the token and base URL reach Orca only when the
# guard came up -- is a decision that has to be made before Orca is
# started. What can safely wait is this: checking that it is still
# listening, and restarting it if it is not.
#
# Idempotent: a guard that is answering makes this a probe and nothing
# else, which is the state every start after the first one finds.
#
# The real key reaches this step and no other. provision-run.sh strips it
# from the environment every other step inherits and hands it back here by
# name, because a key in a place no chokepoint can see is the exact failure
# the guard exists to prevent.
#
# And it goes no further than this shell: a guard restarted from here is
# handed the key over a mode-600 file it reads once and unlinks
# (claude-orca-qa2.25). The guard runs as the same uid as every terminal in
# this container, so `env OPENROUTER_API_KEY=<key> python3 guard.py` would
# publish it in that process's argv and /proc/<pid>/environ for the whole
# uptime of the thing whose job is to keep it hidden.

set -uo pipefail
. "$(dirname "$0")/../provision-lib.sh"

GUARD_PORT="${CLAUDE_ORCA_GUARD_PORT:-4141}"
GUARD_SCRIPT="${CLAUDE_ORCA_GUARD_SCRIPT:-$STEP_TREE/scripts/container/openrouter-guard.py}"
GUARD_TIMEOUT="${CLAUDE_ORCA_GUARD_TIMEOUT:-30}"
GUARD_LOG="$RUN_DIR/openrouter-guard.log"
GUARD_PID_FILE="$RUN_DIR/openrouter-guard.pid"
GUARD_TOKEN_FILE="$RUN_DIR/openrouter-guard.token"
GUARD_KEY_FILE="$RUN_DIR/openrouter-guard.key"
REAL_KEY="${CLAUDE_ORCA_OPENROUTER_REAL_KEY:-}"
# The second caller this step has is a person re-running it by hand
# (`provision run 70-openrouter-guard`), who should not have to put a key
# on their own command line either: a key file is accepted here too.
KEY_FILE_IN="${CLAUDE_ORCA_OPENROUTER_KEY_FILE:-}"
if [ -z "$REAL_KEY" ] && [ -n "$KEY_FILE_IN" ]; then
    [ -s "$KEY_FILE_IN" ] && REAL_KEY="$(head -1 "$KEY_FILE_IN" | tr -d '\r\n')"
    rm -f "$KEY_FILE_IN"
fi
# Out of the environment before this step spawns anything. A shell variable
# is this process's own; an exported one is every child's, and one of those
# children is the guard -- which would put the key straight back into the
# /proc/<pid>/environ this whole change exists to empty.
unset CLAUDE_ORCA_OPENROUTER_REAL_KEY CLAUDE_ORCA_OPENROUTER_KEY_FILE

if ! command -v python3 >/dev/null 2>&1; then
    echo "python3 not found; the OpenRouter guard cannot run here" >&2
    exit 0
fi

guard_port_open() {
    python3 -c "import socket,sys
s = socket.socket()
s.settimeout(0.3)
sys.exit(0 if s.connect_ex(('127.0.0.1', $GUARD_PORT)) == 0 else 1)" \
        >/dev/null 2>&1
}

if [ -z "$REAL_KEY" ]; then
    echo "no OPENROUTER_API_KEY in this folder; there is nothing to guard"
    exit 0
fi

if guard_port_open; then
    echo "the OpenRouter guard is answering on 127.0.0.1:$GUARD_PORT"
    exit 0
fi

# Not answering. A restart is only worth anything if it comes back up on
# the token Orca's environment already carries -- a fresh one would be a
# credential every terminal in this container has never heard of.
if [ ! -s "$GUARD_TOKEN_FILE" ]; then
    echo "the guard is not answering on 127.0.0.1:$GUARD_PORT and $GUARD_TOKEN_FILE is empty: it never started this boot, and a new token is one no terminal here carries. Agents have no OpenRouter access this run -- that is deliberate, because an unpoliced key in a terminal is what the guard exists to prevent." >&2
    exit 1
fi
if [ ! -f "$GUARD_SCRIPT" ]; then
    echo "the guard is not answering and there is no guard script at $GUARD_SCRIPT" >&2
    exit 1
fi

token="$(head -1 "$GUARD_TOKEN_FILE" | tr -d '\r\n')"
echo "the OpenRouter guard is not answering on 127.0.0.1:$GUARD_PORT; restarting it"

# 600 before a byte is in it. The bits are not what makes this safer than a
# variable -- the agent owns both -- the unlink the guard does is.
rm -f "$GUARD_KEY_FILE"
if ! ( umask 077; printf '%s\n' "$REAL_KEY" > "$GUARD_KEY_FILE" ); then
    echo "could not write the guard key file $GUARD_KEY_FILE" >&2
    exit 1
fi
chmod 600 "$GUARD_KEY_FILE" 2>/dev/null

# `env -u` and not just the file: this step inherits OPENROUTER_API_KEY from
# Orca's environment, where it holds the guard TOKEN, and a guard started on
# its own token would authenticate nothing. The guard's own os.environ scrub
# cannot clear /proc/<pid>/environ either -- that is fixed at exec.
env -u OPENROUTER_API_KEY \
    OPENROUTER_GUARD_TOKEN="$token" \
    CLAUDE_ORCA_RUN_DIR="$RUN_DIR" \
    CLAUDE_ORCA_GUARD_KEY_FILE="$GUARD_KEY_FILE" \
    python3 "$GUARD_SCRIPT" --port "$GUARD_PORT" --run-dir "$RUN_DIR" \
    >>"$GUARD_LOG" 2>&1 </dev/null &
guard_pid=$!

waited=0
while [ "$waited" -lt "$GUARD_TIMEOUT" ]; do
    if guard_port_open; then
        printf '%s\n' "$guard_pid" > "$GUARD_PID_FILE"
        echo "the OpenRouter guard is listening again (pid $guard_pid, log: $GUARD_LOG)"
        exit 0
    fi
    kill -0 "$guard_pid" 2>/dev/null || break
    sleep 1
    waited=$((waited + 1))
done

kill -TERM "$guard_pid" 2>/dev/null
rm -f "$GUARD_KEY_FILE"
echo "the OpenRouter guard would not come back up -- see $GUARD_LOG" >&2
exit 1
