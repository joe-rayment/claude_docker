#!/usr/bin/env bash
#
# Register the project with the running Orca, so the folder shows up as a
# repo rather than as a path someone has to add by hand.
#
# Exactly ONE CLI call per provisioning run: registering on a loop would
# re-add the folder every start forever, and tests/container-entrypoint.bats
# holds that line.
#
# Idempotent in the sense that matters here: a second `repo add` for a path
# Orca already knows is a no-op on Orca's side. It skips itself entirely
# when no web URL has been published, which is also what keeps it off the
# Orca-cannot-start path -- registering a project with a server that is not
# there fails silently and teaches nobody anything (claude-orca-qa2.17).

set -uo pipefail
. "$(dirname "$0")/../provision-lib.sh"

URL_FILE="$RUN_DIR/orca-web-url.txt"
if [ ! -s "$URL_FILE" ]; then
    echo "no web URL in $URL_FILE; there is no running Orca to register with"
    exit 0
fi

AGENT_HOME="${HOME:-/home/agent}"
ORCA_BIN="${ORCA_BIN:-/opt/orca/orca-ide}"
USER_DATA_DIR="${ORCA_USER_DATA_DIR:-$AGENT_HOME/.config/orca}"

resolve_cli() {
    if [ -n "${ORCA_CLI:-}" ]; then
        printf '%s\n' "$ORCA_CLI"
        return 0
    fi
    for candidate in \
        "$(dirname "$ORCA_BIN")/resources/bin/orca-ide" \
        "$AGENT_HOME/.local/bin/orca-ide" \
        "$AGENT_HOME/.local/bin/orca"
    do
        [ -x "$candidate" ] && { printf '%s\n' "$candidate"; return 0; }
    done
    for name in orca orca-ide; do
        found="$(command -v "$name" 2>/dev/null)"
        [ -n "$found" ] && { printf '%s\n' "$found"; return 0; }
    done
    return 1
}

cli="$(resolve_cli)"
if [ -z "$cli" ]; then
    echo "no Orca CLI found; skipping repo add" >&2
    exit 0
fi

# The CLI finds the running server through its user-data dir, and it
# defaults to Orca's own rather than the one serve was started with.
# Without this the registration talks to a runtime that is not there.
echo "registering project with Orca: $cli repo add --path $PROJECT_DIR (ORCA_USER_DATA_PATH=$USER_DATA_DIR)"
if command -v timeout >/dev/null 2>&1; then
    env ORCA_USER_DATA_PATH="$USER_DATA_DIR" \
        timeout 60 "$cli" repo add --path "$PROJECT_DIR" --json
else
    env ORCA_USER_DATA_PATH="$USER_DATA_DIR" \
        "$cli" repo add --path "$PROJECT_DIR" --json
fi
