#!/usr/bin/env bash
#
# The scratch volumes' migration (claude-orca-1eh). The launcher mounts
# docker volumes under the agent home (.cache, .npm, .local/share/opencode,
# worktrees -- see volume-dirs.sh); /home/agent is the SAME host directory
# as $PROJECT_DIR/.claude-dev/home, so once a volume sits on one of those
# paths the old bind-mounted copy is shadowed -- still there, still on the
# slow macOS share, and invisible to the agent. This step moves what is
# worth moving and deletes what is regenerable, so a folder that predates
# the volumes does not keep paying for the share.
#
# The guard below is the point of the whole step. Without the volume, D and
# legacy are the SAME directory (same device, same inode) and a delete
# would destroy live data -- so nothing is touched unless stat -c %d says
# the two really are different filesystems. A folder that runs this step
# without the volumes mounted changes nothing, and says so.
#
# Runs as the agent, is idempotent (a migrated dir carries a
# .migrated-from-home marker, and a legacy whose removal succeeds is simply
# gone; one whose rmdir fails -- on the Mac it is the volume's mount point
# in the other view -- is emptied and left behind, and the log says so),
# and its exit code is its status.

set -uo pipefail
. "$(dirname "$0")/../provision-lib.sh"
. "$STEP_TREE/scripts/container/volume-dirs.sh"

AGENT_HOME="${CLAUDE_ORCA_AGENT_HOME:-${HOME:-/home/agent}}"

# On the Mac the legacy path IS the volume's mount point in the /workspace
# view, so rmdir fails EBUSY there on every boot: empty the shadowed copy
# with find -delete, try rmdir, and say only what actually happened.
clear_legacy() {  # clear_legacy <vol> <what> <legacy>
    local vol="$1" what="$2" legacy="$3"
    if [ -z "$(find "$legacy" -mindepth 1 -print -quit 2>/dev/null)" ]; then
        echo "$vol: shadowed $what $legacy is already empty"
        rmdir "$legacy" 2>/dev/null
        return 0
    fi
    if ! find "$legacy" -mindepth 1 -delete 2>/dev/null \
       || [ -n "$(find "$legacy" -mindepth 1 -print -quit 2>/dev/null)" ]; then
        echo "$vol: could not empty $legacy" >&2
        exit 1
    fi
    if rmdir "$legacy" 2>/dev/null; then
        echo "$vol: removed shadowed $what $legacy"
    else
        echo "$vol: emptied shadowed $what $legacy; the directory stays (it is the volume's mount point)"
    fi
}

while IFS= read -r vol; do
    rel="${vol#"$AGENT_HOME"/}"
    legacy="$PROJECT_DIR/.claude-dev/home/$rel"

    # --- the guard --------------------------------------------------------
    if [ -z "$PROJECT_DIR" ] || [ ! -d "$legacy" ]; then
        echo "$vol: no legacy copy at $legacy -- nothing to migrate"
        continue
    fi
    if ! mountpoint -q "$vol" 2>/dev/null \
       || [ "$(stat -c %d "$vol" 2>/dev/null)" = "$(stat -c %d "$legacy" 2>/dev/null)" ]; then
        echo "$vol: not a separate mount -- untouched"
        continue
    fi

    case "$rel" in
        .cache|.npm)
            # Regenerable caches: the shadowed copy is disposable.
            clear_legacy "$vol" "cache" "$legacy"
            ;;
        .local/share/opencode)
            # The sessions db and auth: NOT regenerable, so copy first and
            # delete last. Entries already on the volume are never
            # overwritten -- a collision lands as <entry>.from-home.
            if [ -e "$vol/.migrated-from-home" ]; then
                clear_legacy "$vol" "opencode data" "$legacy"
                continue
            fi
            rm -rf "$vol/.migrating"
            if ! cp -a "$legacy/." "$vol/.migrating/"; then
                rm -rf "$vol/.migrating"
                echo "$vol: copy from $legacy failed; legacy left intact" >&2
                exit 1
            fi
            for entry in "$vol/.migrating"/* "$vol/.migrating"/.[!.]* \
                         "$vol/.migrating"/..?*; do
                [ -e "$entry" ] || continue
                name="$(basename "$entry")"
                if [ -e "$vol/$name" ]; then
                    mv "$entry" "$vol/$name.from-home"
                else
                    mv "$entry" "$vol/$name"
                fi
            done
            rmdir "$vol/.migrating" 2>/dev/null || rm -rf "$vol/.migrating"
            : > "$vol/.migrated-from-home"
            echo "$vol: migrated $legacy onto the volume"
            clear_legacy "$vol" "opencode data" "$legacy"
            ;;
        *)
            # Worktrees and anything else: nothing to migrate, nothing to
            # delete. Orca's worktree base was pointed at the volume by
            # seed-orca-state.sh; worktrees already under .orca-worktrees
            # keep working where they are (git tracks them by path).
            echo "$vol: nothing to migrate -- untouched"
            ;;
    esac
done < <(volume_dirs "$AGENT_HOME")

exit 0
