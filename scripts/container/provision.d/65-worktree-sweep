#!/usr/bin/env bash
#
# claude-orca-6zg -- the boot-time sweep now delegates: one sweep,
# scripts/worktree-gc.sh, owns the whole cleanup. This step used to remove
# stale worktrees only -- it never deleted a branch and never touched the
# delegate job dirs, whose npm/opencode caches alone measured 329 MB in
# this folder. worktree-gc.sh does all three in one pass: the worktree
# semantics below (unchanged, so `provision status` reads the same),
# merged local branches via `git branch -d`, and home/ + config/ of
# finished delegate jobs. Work that is NOT merged is reported STRANDED
# with its commit count and is never deleted -- uncommitted or unmerged
# work stays impossible to miss.
#
# Kept from the old step: the early exits. A folder with no PROJECT_DIR,
# or one that is not a git repo, has nothing to sweep and must not turn
# the boot's provision status red.

set -uo pipefail

if [ -z "${PROJECT_DIR:-}" ] || [ ! -d "$PROJECT_DIR" ]; then
    echo "no PROJECT_DIR; nothing to sweep"
    exit 0
fi
if ! git -C "$PROJECT_DIR" rev-parse --git-dir >/dev/null 2>&1; then
    echo "$PROJECT_DIR is not a git repo; nothing to sweep"
    exit 0
fi

step_dir="$(cd "$(dirname "$0")" && pwd)"
exec "$step_dir/../../worktree-gc.sh" --project "$PROJECT_DIR"
