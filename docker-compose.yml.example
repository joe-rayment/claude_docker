services:
  claude-dev:
    build:
      context: .
      dockerfile: Dockerfile
    image: claude-code-dev:latest
    container_name: claude-dev-environment

    # Interactive terminal
    stdin_open: true
    tty: true

    # Volume mounts
    volumes:
      # Mount your project as workspace (set PROJECT_PATH in .env)
      - ${PROJECT_PATH:-.}/:/workspace
      # Persistent home directory (includes .claude, .gitconfig, .zsh_history, etc.)
      - agent-home:/home/agent

    # Network configuration
    network_mode: bridge

    # Working directory
    working_dir: /workspace

    # Health check
    healthcheck:
      test: ["CMD-SHELL", "claude auth status 2>/dev/null || exit 1"]
      interval: 60s
      timeout: 10s
      retries: 2
      start_period: 30s

    # Keep container running
    command: /bin/zsh

volumes:
  agent-home:
    driver: local
