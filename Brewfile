# beads: gastownhall/beads ships a Homebrew *core* formula -- "brew install
# beads" needs no tap (checked: gh api repos/gastownhall/beads/contents/
# docs/getting-started/installation.md says "Homebrew core's `beads` formula
# is the supported Homebrew package"). So it lists here directly; there is
# no tarball-fallback branch in scripts/install-tools.sh for it.
brew "git"
brew "gh"
brew "jq"
brew "ripgrep"
brew "node"
brew "bats-core"
brew "beads"
